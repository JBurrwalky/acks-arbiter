        <rule>Clusters share the same territory but do not cooperate.</rule>
        <rule>A usable tunnel is a 5' diameter tube, 60' to 150' long ([1d10 + 5] × 10).</rule>
      </population_rules>
      <terrain>
        <primary>rich soil of forests</primary>
        <secondary>rich soil of farmlands</secondary>
      </terrain>
      <reaction_or_pursuit_behavior>
        <rule>An ankheg usually lies 5' to 10' below the surface until its antennae detect approaching prey, then burrows up to attack.</rule>
      </reaction_or_pursuit_behavior>
    </encounter_profile>
    <combat_profile>
      <attack_routines>
        <attack_routine name="bite">
          <usage>default</usage>
          <attack_sequence>
            <attack type="bite" count="1" damage="3d6 (+ 1d4)"/>
          </attack_sequence>
        </attack_routine>
        <attack_routine name="acid_spit">
          <usage>conditional</usage>
          <attack_sequence>
            <attack type="acid line" count="1" damage="4d8"/>
          </attack_sequence>
          <notes>30' line.</notes>
        </attack_routine>
      </attack_routines>
      <attack_effects>
        <attack_effect attack_name="bite">
          <damage>3d6 bite damage plus 1d4 digestive acid damage.</damage>
          <save type="Paralysis" on_success="not grabbed" on_failure="grabbed"/>
          <effect>On a hit, the target must save versus Paralysis or be grabbed.</effect>
          <termination>Grabbed victims remain helpless until they succeed on a saving throw versus Paralysis on their turn.</termination>
          <follow_up>Once it has grabbed prey, the ankheg retreats down its tunnel, dragging the victim.</follow_up>
        </attack_effect>
        <attack_effect attack_name="acid_spit">
          <trigger>Used only when desperate or frustrated.</trigger>
          <damage>4d8</damage>
          <save type="Blast" on_success="half damage" on_failure="full damage"/>
          <effect>Spits acid in a 30' line.</effect>
          <limitations>
            <limitation>After one acid spit, the ankheg's acid supply is depleted for 6 hours.</limitation>
            <limitation>It will only spit acid when reduced to fewer than half its hit points or when it has not successfully grabbed an opponent.</limitation>
          </limitations>
        </attack_effect>
      </attack_effects>
      <mobility_rules>
        <rule>An ankheg burrows with legs and mandibles.</rule>
        <rule>A burrowing ankheg usually does not make a usable tunnel.</rule>
        <rule>When constructing a usable tunnel, it burrows at half speed.</rule>
        <rule>If damaged after grabbing prey, it retreats backward down its tunnel at land speed instead of burrow speed.</rule>
      </mobility_rules>
      <targeting_constraints>
        <constraint>Acid spit affects a 30' line.</constraint>
      </targeting_constraints>
    </combat_profile>
    <special_abilities>
      <ability name="grab">
        <trigger>The ankheg hits with its bite.</trigger>
        <effect>The target must save versus Paralysis or be grabbed and rendered helpless.</effect>
        <save type="Paralysis" on_success="not grabbed" on_failure="grabbed and helpless"/>
        <termination>The victim escapes by making a successful saving throw versus Paralysis on its turn.</termination>
      </ability>
      <ability name="acid_spit">
        <trigger>The ankheg is desperate or frustrated.</trigger>
        <effect>The ankheg spits a 30' line of acid for 4d8 damage.</effect>
        <save type="Blast" on_success="half damage" on_failure="full damage"/>
        <limitation>One use depletes the acid supply for 6 hours.</limitation>
        <exception>It only uses this when reduced to fewer than half its hit points or when it has not successfully grabbed an opponent.</exception>
      </ability>
    </special_abilities>
    <ecology_and_behavior>
      <habitat>
        <rule>Commonly tunnels up to 40' below the surface in the rich soil of forests or farmlands.</rule>
      </habitat>
      <diet>
        <rule>Eats fresh meat.</rule>
      </diet>
      <social_structure>
        <rule>Clusters share territory but do not cooperate.</rule>
      </social_structure>
      <behavior_rules>
        <rule>Ambushes prey from below ground after detecting approach with its antennae.</rule>
      </behavior_rules>
    </ecology_and_behavior>
    <treasure_and_rewards>
      <treasure_type>M</treasure_type>
    </treasure_and_rewards>
    <procedures>
      <procedure name="tunnel_ambush">
        <condition>The ankheg is waiting in a prepared tunnel.</condition>
        <steps>
          <step number="1">The ankheg lies in its tunnel, usually 5' to 10' below the surface.</step>
          <step number="2">It detects approaching prey with its antennae.</step>
          <step number="3">It burrows up to attack.</step>
        </steps>
        <outcome>The ankheg engages prey from an ambush position.</outcome>
      </procedure>
      <procedure name="drag_grabbed_prey">
        <condition>The ankheg has successfully grabbed a victim.</condition>
        <steps>
          <step number="1">The ankheg retreats down its tunnel at burrow speed, dragging the victim.</step>
          <step number="2">If the ankheg is damaged after grabbing prey, it instead retreats backward at land speed.</step>
        </steps>
        <outcome>The victim is dragged into the tunnel while helpless.</outcome>
        <follow_up>The victim remains helpless until escaping with a successful save versus Paralysis on its turn.</follow_up>
      </procedure>
    </procedures>
    <tables/>
    <references>
