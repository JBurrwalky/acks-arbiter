  <wilderness_wandering_monsters>
    <encounter_check>
      <frequency>
        <rule>If the party is stationary, check once per day.</rule>
        <rule>If the party is in settled terrain, check once per day.</rule>
        <rule>Otherwise, check each time the adventurers enter a new 6-mile hex.</rule>
      </frequency>
      <die>1d6</die>
      <terrain_based_target>Use the Encounter Frequency by Terrain table.</terrain_based_target>
    </encounter_check>

    <procedure>
      <step order="1">Roll 1d8 on the appropriate terrain column of the Wilderness Encounters by Terrain table to determine a sub-table.</step>
      <step order="2">Roll 1d12 on the resulting sub-table to determine the creature encountered.</step>
      <step order="3">Find the creature in the monster chapter and roll against its % In Lair to determine whether it is in its lair.</step>
      <step order="4">If the creature is in its lair, a dynamic lair can be used if one is available.</step>
      <step order="5">If the creature is not in its lair, roll the normal number encountered for that creature.</step>
      <step order="6">If the encounter is in the creature's lair, roll against the creature's Treasure Type.</step>
      <step order="7">Roll on the Wilderness Encounter Distance table to determine the number of yards from the characters to the creature(s) or lair at the start of the encounter.</step>
      <distance_rules>
        <rule>If the creature is in its lair, encounter distance is the distance to the lair.</rule>
        <rule>If the creature is outside its lair, encounter distance is the distance to the creature.</rule>
      </distance_rules>
      <post_generation>
        <rule>Roll for surprise, initiative, and reaction using the wilderness encounter rules.</rule>
      </post_generation>
    </procedure>

