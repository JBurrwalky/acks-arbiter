<?xml version="1.0" encoding="UTF-8"?>
<acks_wandering_monsters_summary title="ACKS Core - Wandering Monsters" summary_scope="rules, procedures, definitions, tables" flavor_excluded="true" source_count="1">
  <document_notes>
    <note>This summary covers wandering monster procedures for dungeons and wilderness, dungeon wandering monster table design guidance, wilderness sub-table selection, and NPC party generation.</note>
    <note>Mechanical prose, procedures, and tables are preserved. Flavor text, quotations, examples, and illustrations are omitted.</note>
    <note>Some wilderness table cells appear merged or malformed in the source text conversion. Where this occurred, the source wording is preserved exactly rather than normalized by guesswork.</note>
  </document_notes>

  <definitions>
    <definition term="wandering_monster">A monster encountered while moving, hunting, exploring, or otherwise away from a fixed lair; some such creatures may have no lair at all.</definition>
    <definition term="encounter_throw">A periodic die roll used to determine whether a wandering monster encounter occurs.</definition>
    <definition term="random_monster_table_used">For dungeon encounters, the monster level table selected from the Dungeon Wandering Monster Level table before rolling the actual monster.</definition>
    <definition term="base_level">For NPC parties, the average level for the party as a whole, used to derive each NPC's actual level.</definition>
  </definitions>

  <core_rule>
    <rule>The Judge checks periodically for wandering monsters by making an encounter throw.</rule>
    <rule>Encounter throw frequency and target number vary by activity and location.</rule>
    <rule>If an encounter throw indicates a wandering monster, the Judge consults the appropriate wandering monster tables and adjudicates the encounter using the encounter rules.</rule>
  </core_rule>

  <dungeon_wandering_monsters>
    <encounter_check>
      <frequency>Every 2 turns while characters are in a dungeon.</frequency>
      <die>1d6</die>
      <encounter_on>6+</encounter_on>
      <modifiers>
        <rule>Modify the die roll if characters are exceptionally loud or stealthy.</rule>
        <rule>Modify the die roll based on how inhabited or desolate the area is.</rule>
        <rule>Other situational factors may also modify the encounter throw.</rule>
      </modifiers>
      <table_selection>Use the wandering monster table appropriate to the dungeon level where the encounter occurs.</table_selection>
    </encounter_check>

    <procedure>
      <step order="1">
        <action>Find the row matching the dungeon level on the Dungeon Wandering Monster Level table.</action>
        <action>Roll 1d12 and read across that row to determine which Random Monsters by Level table to use.</action>
        <action>Roll 1d12 on the selected Random Monsters by Level table to determine the creature type.</action>
      </step>
      <step order="2">
        <action>Roll the creature's normal number encountered.</action>
        <adjustment>Increase or decrease the rolled result by one-half for each step of difference between the dungeon level and the Random Monster table used.</adjustment>
        <rounding>Round down.</rounding>
      </step>
      <step order="3">
        <action>Roll 2d6 x 10 feet for encounter distance.</action>
        <rule>This is the distance separating characters and monster(s) when the characters may become aware of the monster(s).</rule>
        <exception>Light source, dungeon geometry, or other factors may override this distance.</exception>
        <judge_guidance>The Judge determines the direction of approach using dungeon layout and known placement of other monsters.</judge_guidance>
      </step>
      <post_generation>
        <rule>Roll for surprise and reaction using the dungeon encounter rules.</rule>
        <reaction_modifier>Modify the reaction roll by the difference between the Random Monster table used and the dungeon level of the encounter.</reaction_modifier>
        <reaction_logic>
          <rule>If monsters from a lower-level table are encountered deeper in the dungeon, they receive a penalty to reaction rolls equal to the depth difference.</rule>
          <rule>If monsters from a higher-level table are encountered on an upper level, they receive a bonus to reaction rolls equal to the level difference.</rule>
          <behavior_guidance>Monsters traveling deeper into the dungeon are more likely to attack because of numerical superiority.</behavior_guidance>
          <behavior_guidance>Powerful monsters wandering on upper levels are more likely to see the party as tools rather than threats.</behavior_guidance>
        </reaction_logic>
      </post_generation>
    </procedure>

    <table_design_guidelines>
      <rule>Dungeon wandering monster tables should provide a mix of challenge types.</rule>
      <rule>Entries 1-4 are typically beastmen or other organized group monsters.</rule>
      <rule>Entries 5-8 are typically animals, vermin, or instinct-driven creatures.</rule>
      <rule>Entries 9-12 are typically men and monsters: less communal, more independent, and often more intelligent and/or supernatural.</rule>
      <rule>The last entry in the men and monsters category is always reserved for NPC parties.</rule>
      <rule>Tables should support varied treasure placement as well as varied challenge types.</rule>
      <rule>Most or all monsters on a table should be appropriate to the intended dungeon level, following the Wandering Monster Table Guidelines.</rule>
      <rule>Variation in actual challenge is still produced by the Dungeon Wandering Monster Level table, which can direct encounters to stronger or weaker monster tables than the current dungeon level.</rule>
    </table_design_guidelines>

