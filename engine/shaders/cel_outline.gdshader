// cel_outline.gdshader
// Inverted-hull outline pass per gdd-art-direction.md §6.5.
//
// Technique: applied to a sibling "outline mesh" that's a duplicate of the primary figure mesh
// (auto-generated by acks-blender-pipeline/scripts/export_godot.py per gdd-character-creation-pipeline.md §4.2,
// at 50-70% polycount for performance).
//
// The outline mesh:
//   - Vertex positions are expanded along the smooth vertex normal by `outline_thickness`.
//   - Front faces are culled (only back faces visible).
//   - Depth-tested normally so the primary mesh occludes the outline where the figure is solid.
//   - Shaded with a flat color (no lighting), producing a silhouette outline.
//
// Distance-pinned thickness (§3.2): thickness is in OBJECT-SPACE units (not screen-space),
// so a figure at the edge of the playable area has the same visible outline width as a figure
// at the center. This is the GDD's "drawn-line signature" — distance-scaled outlines read as
// "engine effect" and are explicitly rejected.
//
// Performance: this is a second draw call per figure. §6.7.1 mandates distance-based outline LOD
// — figures beyond a threshold distance disable their outline entirely. The threshold is set
// in the per-character GDScript, not in the shader.

shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_front, unshaded;

uniform float outline_thickness : hint_range(0.0, 0.1) = 0.008;
uniform vec4 outline_color : source_color = vec4(0.051, 0.039, 0.031, 1.0);  // #0d0a08

// Per-vertex outline thickness modulation via UV2.y (baked from the basemesh's
// `Outline Thickness` vertex group). Assets without this baked data should set false.
uniform bool use_vertex_color_thickness = false;

// Hide-region uniforms — mirror cel_figure.gdshader. Outline fragments are discarded for
// hidden regions so we don't get a "ghost outline" around hidden body parts.
uniform int hide_mask = 0;
uniform bool use_hide_mask = false;
uniform int debug_hide_region = -1;

varying flat int v_region_id;

void vertex() {
    v_region_id = int(UV2.x * 255.0 + 0.5);

    // Expand along the smooth vertex normal in object space. Per-vertex thickness from UV2.y.
    float thickness = outline_thickness;
    if (use_vertex_color_thickness) {
        thickness *= UV2.y;
    }
    VERTEX += NORMAL * thickness;
}

void fragment() {
    int region = v_region_id;
    if (debug_hide_region >= 0 && region == debug_hide_region) {
        discard;
    }
    if (use_hide_mask && region < 10 && (hide_mask & (1 << region)) != 0) {
        discard;
    }
    ALBEDO = outline_color.rgb;
}
