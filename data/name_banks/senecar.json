  "religion": {
    "_note": "Deity-names are fused morphs of the Agrippan canon (Celtic + Iroquoian), never real Celtic/Iroquois gods. Senecar seeds/shifts Neutral or Chaotic; its stance follows its CURRENT alignment (see worship_by_alignment). The powers are met in the nemed-grove and the deep forest; the spirit-keepers (fused druid-and-faithkeeper) mediate; the ancestral dead and the Tuath-spirits are honored at the cairn and the burial-grove.",
    "clergy_ladder": {
      "1": "Drui-deshi (lore-novice)",
      "3": "Druiweienon (grove-keeper)",
      "5": "Faithonon (seer-keeper)",
      "7": "Ardrui-tha (arch-keeper)",
      "9": "Ollamonon (supreme sage-keeper)"
    },
    "demon_epithet_pattern": "the demonized set (the Lawful powers + the One, when Chaotic) take dread epithets: Tulrius -> Toranon the Cold-Light; Orlandus -> Oranlon the Oath-Chain; Aeternus -> Eteronon the Far Tyrant.",
    "holy_symbol_motifs": {
      "Gaianon": "a great forest-tree rooted in the earth",
      "Realwen": "a sheltering mother over the planted field",
      "Toranon": "a sun-wheel over the longhouse and the oak"
    },
    "religious_orders_pattern": "the Nemedonon (grove-shrine) of [power] in the deep forest: 'the Nemedonon of Toranon'; the thanksgiving-circle of the clans.",
    "saints_pattern": "the Tuath-spirits (the god-kin and forest-spirits) and the honored clan-mothers and ancestral heroes, kept in the grove-recital.",
    "sample_deity_renames": {
      "Gaiandus": "Gaianon (the enduring earth and forest; Lawful power)",
      "Maraxus": "Marakson (the war-fire; Chaotic power)",
      "Realta": "Realwen (the mother, clan-mother of the powers; Neutral-honored)",
      "Tulrius": "Toranon (the sun, the day-keeper; Lawful power)"
    },
    "the_one": "Eteronon (< Aeternus; fused Celtic Eternan / Iroquoian Aterhonon) - the Sky-Ancient-Above; acknowledged and set aside (Neutral), reviled as the far tyrant when Chaotic",
    "worship_by_alignment": {
      "Chaotic": "venerate the Chaotic powers (Marakson the war-fire, Wasidonon, Rusanon), demonize the Lawful powers and the One (Eteronon)",
      "Neutral": "all powers ambivalent - somewhat honored, somewhat feared; foreground the ancestral dead, the Tuath-spirits and the powers of grove and forest"
    }
  },
