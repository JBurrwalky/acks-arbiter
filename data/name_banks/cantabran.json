      "1": "Aruspex (diviner-acolyte)",
      "3": "Sacron (priest)",
      "5": "Gutuater (high priest)",
      "7": "Drux (druid-lord)",
      "9": "Ard-drux (arch-druid)"
    },
    "demon_epithet_pattern": "each opposing power keeps its morphed name + its own portfolio epithet (distinct per power): Maraxus -> Maraxos the Burning; Metensia -> Metensoc the Wasting; Desoria -> Desoryos the Drowner.",
    "holy_symbol_motifs": {
      "Caiandos": "grey peak beneath a stag's antlers",
      "Orlanno": "twin spears over an oath-ring"
    },
    "religious_orders_pattern": "the Nemeton (sacred grove) of [power]: 'the Nemeton of Caiandos'.",
    "saints_pattern": "ancestral hero venerated at his hillfort-tomb (the [name] of [briga]).",
