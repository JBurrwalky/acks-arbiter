  "religion": {
    "_note": "Deity-names are morphs of the Agrippan canon (Slavic primary, from family_slavic theonym_set; Germanic variant, from family_germanic reflexes), never real Slavic/Germanic gods. Venedan seeds/shifts Neutral or Chaotic; its stance follows its CURRENT alignment (see worship_by_alignment). The volkhv keeps the kapishche-idol in the sacred grove; the Dedy (ancestral dead) are honored at the kurgan; the march war-bands keep a Germanic alhs-grove.",
    "clergy_ladder": {
      "1": "Vedun (diviner-novice)",
      "3": "Zhrets (sacrificer-priest)",
      "5": "Volkhv (priest-sorcerer)",
      "7": "Gudja (Germanic priest, overlay)",
      "9": "Verhovny Volkhv (supreme priest)"
    },
    "demon_epithet_pattern": "the demonized set (the Lawful powers + the One, when Chaotic) take dread epithets: Tulrius -> Tulor the Soft-Sun; Orlandus -> Orlon the Oath-Chain; Aeternus -> Oterun the Sky-Tyrant.",
    "holy_symbol_motifs": {
      "Goyan": "the black earth beneath the plough",
      "Numir": "an axe and thunder-mark above an oak",
      "Relata": "the spinning-distaff above grain-sheaves"
    },
    "religious_orders_pattern": "the Kapishche (idol-shrine) of [power] in the grove, and the march Alhs (Germanic grove): 'the Kapishche of Numir', 'the Alhs of Marahs'.",
    "saints_pattern": "the Dedy (ancestral dead) and rod-spirits at the kurgan; the war-bands honor their Germanic forebears (the Anses).",
    "sample_deity_renames": {
      "Gaiandus": "Goyan (Gmc Gauands) - the enduring earth; Lawful power",
      "Maraxus": "Marakh (Gmc Marahs) - the war-fire; Chaotic power",
      "Numeno": "Numir (Gmc Numins) - the sky-thunder, the storm-word; Lawful power",
      "Realta": "Relata (Gmc Riala) - the mother, mercy; Neutral-honored"
    },
    "the_one": "Oterun (< Aeternus; Germanic variant Aiterns) - the distant Heaven-Father; reviled as the cold sky-tyrant when Chaotic, acknowledged when Neutral",
    "worship_by_alignment": {
      "Chaotic": "venerate the Chaotic powers (Marakh, Vakid, Lusan), demonize the Lawful powers and the One (Oterun)",
      "Neutral": "all powers ambivalent - somewhat honored, somewhat feared; foreground the Dedy (ancestral dead), the rod-spirits and the land-powers"
    }
