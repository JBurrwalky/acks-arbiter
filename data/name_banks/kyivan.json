  "religion": {
    "_note": "Deity-names are the Slavic morphs of the Agrippan canon (family_slavic.json theonym_set) under a Byzantine-Greek (Hellenized) overlay (-ios/-ia endings) - never real Slavic or Greek gods. Lawful/Neutral henotheist: under the Hellenization the One (Otirios) is raised supreme and worshipped in golden-domed sobors; the old kapishche idols give way to the ikona and the monastyr. Neutral folk still keep the Dedy (ancestral dead) at the grave.",
    "clergy_ladder": {
      "1": "Chtets (reader/acolyte)",
      "3": "Ierei (priest; Gk. hiereus)",
      "5": "Protoierei (archpriest)",
      "7": "Episkop (bishop; Gk. episkopos)",
      "9": "Mitropolit (metropolitan; Gk. metropolites)"
    },
    "demon_epithet_pattern": "the opposing powers keep their Slavic-Greek morphs + a portfolio epithet (distinct per power): Maraxus -> Marakhios the War-Fire; Vacidus -> Vakidios the Unmaker; Lusanto -> Lusanios the Hoard-Serpent.",
    "holy_symbol_motifs": {
      "Otirios": "an all-seeing eye within a golden dome",
      "Relatia": "the veiled mother above a healing-spring",
      "Tulorios": "a sun-disc above a domed sanctuary"
    },
    "religious_orders_pattern": "the Monastyr (monastery) or Sobor (cathedral) of [power]: 'the Sobor of Tulorios', golden-domed, with ikony within.",
    "saints_pattern": "Svyatyi [name] (saint), Greek-form names favored; the Dedy (ancestral dead) still honored at the grave by the Neutral.",
    "sample_deity_renames": {
      "Numeno": "Numirios (the sky-wisdom, the storm-word)",
      "Orlandus": "Orlonios (the iron-oath, war)",
      "Realta": "Relatia (the mother, mercy)",
      "Tulrius": "Tulorios (the sun, the just light)"
    },
    "the_one": "Otirios (< Slavic Oterun < Aeternus; God Most High, raised supreme under the Hellenization, worshipped in the domed churches)"
  },
