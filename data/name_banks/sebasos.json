  "religion": {
    "_note": "Deity-names are morphs of the Agrippan canon (Hellenic reflexes primary, from classical theonym treatment; Egyptian variants secondary, from near_eastern theonym_sets), never real Greek/Egyptian gods. The Ptolan fuse the two cults (a Serapis-style syncretism): each power has a Hellenic court-name and an Egyptian temple-name, held to be one. Ptolan stance follows its CURRENT alignment (see worship_by_alignment). The polis-temple and the Egyptian Per-netjer keep the rites together.",
    "clergy_ladder": {
      "1": "Neokoros (temple-keeper)",
      "3": "Hiereus (priest)",
      "5": "Archiereus (high priest)",
      "7": "Hem-netjer Tepy (first prophet, Egy overlay)",
      "9": "Megas Hierophant"
    },
    "demon_epithet_pattern": "the demonized set (the Chaotic powers, when Lawful) take dread epithets: Maraxus -> Maraxos the Tyrant-Flame (Egy. Marakhu the City-Burner); Vacidus -> Wakedjet the Devourer; Lusanto -> Lusandros the Coin-Serpent.",
    "holy_symbol_motifs": {
      "Aiternos": "the winged disc above the polis-eagle",
      "Realta": "a sheltering mother-goddess over the lotus",
      "Tulrios": "a radiate sun above the double crown"
    },
    "religious_orders_pattern": "the Temenos (sacred precinct) or Per-netjer (god's-house) of [power]: 'the Temenos of Tulrios', 'the Per-netjer of Tjuraa'.",
    "saints_pattern": "deified kings and founder-heroes (Greek Heros [name]; Egyptian the justified dead, maa-kheru), venerated at the temple and the royal tomb.",
    "sample_deity_renames": {
      "Maraxus": {
        "gloss": "the war-fire; Chaotic, demonized",
        "primary": "Maraxos",
        "primary_family": "classical",
        "secondary": "Marakhu",
        "secondary_family": "near_eastern"
      },
      "Numeno": {
        "gloss": "sky-wisdom; Lawful",
        "primary": "Numenos",
        "primary_family": "classical"
      },
      "Realta": {
        "gloss": "the mother; Neutral-honored",
        "primary": "Realta",
        "primary_family": "classical",
        "secondary": "Riaret",
        "secondary_family": "near_eastern"
      },
      "Tulrius": {
        "gloss": "sun and right-order; Lawful",
        "primary": "Tulrios",
        "primary_family": "classical",
        "secondary": "Tjuraa",
        "secondary_family": "near_eastern"
      }
    },
    "the_one": "Aiternos (< Aeternus; Egyptian temple-name Atjernaa) - the One, revered as the Most High when Lawful, acknowledged but set aside when Neutral, defied as the tyrant-god when Chaotic",
    "worship_by_alignment": {
      "Chaotic": "venerate the Chaotic powers of the canon (Maraxos/Marakhu and their kin), and name the Lawful powers - and the One - as the tyrant-gods to be defied",
      "Lawful": "revere the One (Aiternos/Atjernaa) and the Lawful powers (Tulrios, Orlandros, Numenos, Gauandos), demonize the Chaotic powers",
      "Neutral": "all powers ambivalent; foreground the deified ancestors (the justified dead) and the local temple-cults of place"
    }
  },
  "schema_version": 1,
  "tier": "culture",
  "titles": {
    "_tiers_note": "Hellenic backbone, ascending, with an Egyptian overlay at the nome and the crown. DISPLAY titles are English except two approved foreign terms: Archon (the Greek polis-magistrate) at county, and Pharaoh at kingdom (the Ptolemies styled themselves Pharaoh - the realm's iconic throne). ruler_native carries the full Greek register: Toparch barony; Phrourarch (garrison-commander) march; Nomarch (governor of an Egyptian nome) county; Strategos (general-governor) duchy; Dynastes (prince) principality; Basileus (king) kingdom; Basileus Megas, styled Per-aa (Pharaoh) to the native temples, empire. The Greek court and the Egyptian priesthood share the rule. (Rank titles are the real Greek/Egyptian register, allowed.)",
    "approved_foreign_terms_used": [
      "Archon (county)",
      "Pharaoh (kingdom)"
    ],
    "display_policy": "Ruler/domain titles shown in setting-gen, domain lists and vassal trees are ENGLISH (or an approved commonly-known foreign term where set in 'ruler'). The *_native conlang forms are for NPC DIALOGUE ONLY, never for structural/UI displays.",
