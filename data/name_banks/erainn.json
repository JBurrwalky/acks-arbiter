  "religion": {
    "_note": "Deity-names are the Celtic morphs of the Agrippan canon (family_celtic.json theonym_set) in archaic Old Irish form - never real Celtic gods. Lawful/Neutral: an ordered, law-bound druidic high-kingship. The Lawful keep the sun-and-oath powers and the One above them as the sanction of kingship; the Neutral the Tuath-de (god-kin), the ancestral dead and the sovereignty of the land. The brithem's law and the drui-orders mediate.",
    "clergy_ladder": {
      "1": "Mac-legind (student of lore)",
      "3": "Drui (druid)",
      "5": "Fili (poet-seer)",
      "7": "Ard-drui (arch-druid)",
      "9": "Ollam Rig (the king's supreme sage)"
    },
    "demon_epithet_pattern": "the opposing powers keep their Celtic morphs + a portfolio epithet (distinct per power): Maraxus -> Maragan the War-Fire; Vacidus -> Faicid the Unmaker; Lusanto -> Losand the Hoard-Worm.",
    "holy_symbol_motifs": {
      "Gaian": "the sovereignty-cup above green earth",
      "Orlann": "an iron spear crossed with a torc",
      "Toran": "a sun-wheel above the Lia Fail (the king-stone)"
    },
    "religious_orders_pattern": "the Nemed (sanctuary-grove) of [power]: 'the Nemed of Toran'; the high-king's great nemed at Temair.",
    "saints_pattern": "the Tuath-de (god-kin) and the deified ancestors of the ri-line, honored at the royal cairn and the holy well; the Lawful add 'Noeb [name]'.",
    "sample_deity_renames": {
      "Gaiandus": "Gaian (the enduring land, sovereignty of the soil)",
      "Orlandus": "Orlann (the iron-oath, battle)",
      "Realta": "Realtan (the mother, the mercy-star)",
      "Tulrius": "Toran (the sun, the just brightness, sanction of kings)"
    },
    "the_one": "Eternan (< Aeternus; the Ancient One above the god-kin, source of the kingship's right)"
  },
  "schema_version": 1,
  "tier": "culture",
  "titles": {
    "_tiers_note": "Archaic Goidelic high-kingship, ascending. Built on the ri-hierarchy: Ri Tuaithe (king of a tuath) duchy; Ruiri (over-king of tuatha) principality; Ri Coicid (king of a fifth/province) kingdom; Ard Ri (high king at Temair) empire over the Ard-rige. Bo-aire (cattle-lord, propertied noble) barony; Aire Echta (border-avenger lord) march; Tigerna (lord) county. The brithem (judge) and ollam (sage) stand outside the ladder. (Rank titles are the real Old Irish register, allowed.)",
    "female_forms": {
      "Aire Echta": "Ban-aire",
