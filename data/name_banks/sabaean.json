  "religion": {
    "_note": "Deity-names are second-order phoneme-morphs: the canonical Agrippan pantheon as morphed into Punic (Barcan) trade-forms, then drifted through South-Semitic (Ge'ez-kin) phonology with an Akkadian astral coloring \u2014 never real South-Arabian gods. Lawful/Neutral; an incense-temple and astral cult (the sun-power, the moon as His lamp, and the dawn-star) layered over saint/ancestor veneration.",
    "clergy_ladder": {
      "1": "Rashw (temple-servant)",
      "3": "Kahin (priest)",
      "5": "Afkal (diviner-priest)",
      "7": "Kabir-Kahin (high priest)",
      "9": "Resh-Kahin (head of priests)"
    },
    "demon_epithet_pattern": "each opposing power (the Chaotic 13 for this Lawful-leaning realm) keeps its morphed name + its own portfolio epithet (distinct per power): Maraxus -> Marakash the Devourer; Lusanto -> Lusantan the Coin-Serpent; Vacidus -> Wakidan the Void.",
    "holy_symbol_motifs": {
      "Riyalat": "a bull's-head above an incense-altar",
      "Talrish": "a sun-disc between a crescent moon and the dawn-star"
    },
    "religious_orders_pattern": "the Bet (temple) or Mahram (sacred precinct) of [power]: 'the Mahram of Talrish'.",
    "saints_pattern": "the blessed dead and incense-lords, venerated at the Mahram and at pillar-tombs; 'the blessed [name]'.",
    "sample_deity_renames": {
      "Argentus": "Arganu (trade and the caravan-city)",
      "Orlandus": "Warlanu (iron-sworn)",
      "Realta": "Riyalat (the mother / mercy)",
      "Tulrius": "Talrish (the sun-power)"
    },
    "the_one": "Atyaran (< Punic Atharon < Aeternus; God Most High, lord of the high heaven)"
  },
