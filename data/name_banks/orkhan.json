  "religion": {
    "_note": "Deity-names are the Steppe morphs of the Agrippan canon (family_steppe.json theonym_set) - never real Mongol/Turkic gods (no Tengri/Erlik/Ulgen/Umai/Qormusta). The Orkhan are Chaotic alone: they DEMONIZE the One (Eterun) as the Tyrant-Sky of the soft Lawful folk, and revile the Lawful powers as the gods of weak settled men. What they revere is the Wild Storm-Sky (Tamendei) - the untamed, ever-warring heaven that grants dominion to the strong - supreme over the Chaotic war-, plunder- and hunt-powers beneath it. The ovoo (sacred cairn) and the open sky are their altars; they raise no temples.",
    "clergy_ladder": {
      "1": "Bo-shavi (shaman-novice)",
      "3": "Bo (shaman)",
      "5": "Idugan (shamaness)",
      "7": "Ulu-Boge (high shaman)",
      "9": "Tamendiin-Boge (the khan's storm-shaman)"
    },
    "demon_epithet_pattern": "the One and the Lawful powers are the enemy-gods, named with curses: Aeternus -> Eterun the Tyrant-Sky (the chief enemy); Tulrius -> Tulai the Soft-Sun; Orlandus -> Orloch the Oath-Chain; Numeno -> Nomon the Scribe (mocked as the god of weaklings who write).",
    "holy_symbol_motifs": {
      "Marakhai": "a red horsetail war-standard (tug) beneath the storm",
      "Tamendei": "forked lightning across a black storm-sky"
    },
    "religious_orders_pattern": "no temples - the Ovoo (sacred stone-cairn) of [power] on a high place, hung with offerings: 'the Ovoo of Tamendei' atop the pass.",
    "saints_pattern": "the great conqueror-khans and hero-baatars become storm-riders in the Wild Sky; honored at their ovoo and in the shaman's song.",
    "sample_deity_renames": {
      "Dementus": "Tamendei (the Wild Storm-Sky; supreme of the venerated powers)",
      "Lusanto": "Lusantai (the Plunder-Serpent)",
      "Maraxus": "Marakhai (the Conqueror, the War-Fire)",
      "Raptis": "Rabtai (the Wild Hunt, the raid)"
    },
    "the_one": "Eterun (< Aeternus; the One, REVILED here as the Tyrant-Sky - the distant chain the Lawful would lay on free riders; cursed, never petitioned)"
  },
