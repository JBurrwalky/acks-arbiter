  "race": "dwarf",
  "religion": {
    "_note": "Deity-names are the Khraaldurn reflexes of the Dwarven morphs of the Agrippan canon (family_dwarven.json) - never real dwarf-gods; sacred ending -drumm (masc) / -drumma (fem). The MOST ancestor-centric of all dwarves: in the long dark the durnad (honored dead) and fadruun (clan-fathers) are nearly all of daily faith, kept on the longest ancestor-rolls and cairns; the gods are honored only at the great seasonal festivals, foremost the forge (Orluundrumm) and the mountain/mine (Gunduundrumm). Withdrawn, traditional, and overwhelmingly Neutral.",
    "clergy_ladder": {
      "1": "Drok-kun (novice, the hammer-bearer)",
      "3": "Fadruun-warden (keeper of the cairns and ancestor-rolls)",
      "5": "Bral-drumm (forge-priest)",
      "7": "Grund-drumm (high hold-priest)",
      "9": "Dur-Drumm (the realm's high priest)"
    },
    "demon_epithet_pattern": "the demonized set (by current alignment): when Lawful - Lusanto -> Lusuundrumm the Gold-Sickness, Maraxus -> Maraakadrumm the Wrack; when Chaotic - Aeternus -> Atruundrumm the Cold-Vault.",
    "holy_symbol_motifs": {
      "Delruundrumm": "a cairn-stone over crossed bones",
      "Gunduundrumm": "a peak above crossed picks",
      "Orluundrumm": "a hammer crossed over an anvil"
    },
    "religious_orders_pattern": "the Drumgrund (festival-hall) of [power]: 'the Drumgrund of Orluundrumm', and the cairn-rolls of the ancestors kept beside it.",
    "saints_pattern": "the honored forefathers and master-smiths of the clans (the durnad), kept on the longest ancestor-rolls of any dwarves, named at every cairn.",
    "sample_deity_renames": {
      "Delorum": {
        "gloss": "death and the honored dead; the ancestor-warden, central here, masc.",
        "primary": "Delruundrumm",
        "primary_family": "dwarven"
      },
      "Gaiandus": {
        "gloss": "the mountain, the mine, the deep earth; co-foremost, masc.",
        "primary": "Gunduundrumm",
        "primary_family": "dwarven"
      },
      "Orlandus": {
        "gloss": "the forge, the smith, oaths and iron; most honored god, masc.",
        "primary": "Orluundrumm",
        "primary_family": "dwarven"
      },
      "Realta": {
        "gloss": "the hearth-mother, mercy; honored, fem.",
        "primary": "Reltaadrumma",
        "primary_family": "dwarven"
      }
    },
    "the_one": "Atruundrumm (< Aeternus; sacred-masc -drumm; the Stone-Father, the First Shaper; honored at the great festivals, most distant of all from the daily cairn-prayers)",
    "worship_by_alignment": {
      "Chaotic": "the rare few venerate the Chaotic greed- and fire-powers (Lusuundrumm the gold-sickness, Maraakadrumm the forge-fire), demonize the Lawful powers and the One",
      "Lawful": "the orderly minority revere the One (Atruundrumm) and the Lawful powers (Orluundrumm the smith, Gunduundrumm the mountain), demonize the Chaotic powers",
      "Neutral": "the dwarven norm at its deepest: daily prayer to the honored dead (durnad) and clan-fathers (fadruun) at the cairn and tomb-hall, kept on the longest ancestor-rolls; the gods honored only at the great seasonal festivals, foremost the forge (Orluundrumm) and the mountain/mine (Gunduundrumm); the long-dark moon (Noklaadrumma) watched and respected"
    }
  },
