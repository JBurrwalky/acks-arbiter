  "religion": {
    "_note": "Deity-names are fused morphs of the Agrippan canon (Latin + Sinitic), never real Roman/Chinese gods. Serican seeds/shifts Lawful or Neutral; its stance follows its CURRENT alignment (see worship_by_alignment). A Celestial Bureaucracy under the Mandate of Heaven, fused with the Roman law-cult: the One (Aiterneng) is Highest Heaven and source of the Mandate; the Lawful powers the celestial magistracy that gave the law; the templ-miao temple and the law-curia keep the rite.",
    "clergy_ladder": {
      "1": "Cultor-tu (acolyte)",
      "3": "Sacerdshi (priest)",
      "5": "Flamfashi (ritual-master)",
      "7": "Pontgaogong (high priest)",
      "9": "Pontfex Tianshi (celestial master / pontifex maximus)"
    },
    "demon_epithet_pattern": "the Chaotic powers are the demon-marshals outside the celestial order, each with an epithet: Maraxus -> Maraluo the War-Fire Marshal; Vacidus -> Wucidus the Devourer; Lusanto -> Lusanus the Coin-Serpent.",
    "holy_symbol_motifs": {
      "Aiterneng": "the Mandate-eye above the dragon-and-eagle",
      "Numengus": "stylus and codex above the seal of office",
      "Tulin": "a winged sun-disc above the law-stele and the scales"
    },
    "religious_orders_pattern": "the Templ-miao (temple) of [power]: 'the Templ-miao of Tulin'; the law-curia keeps its codex-stele.",
    "saints_pattern": "deified law-givers and worthy officials enrolled in the celestial register; 'Divus [name]' / 'the Lord [name]', honored at the ancestral hall and the miao.",
    "sample_deity_renames": {
      "Numeno": "Numengus (the scribe-wisdom, keeper of the codex; Lawful power)",
      "Orlandus": "Orlanus (the iron-oath, war; Lawful power)",
      "Realta": "Relianta (the mother of mercy; Neutral-honored)",
      "Tulrius": "Tulin (sun and judgment, lord of the law-stele; Lawful power)"
    },
    "the_one": "Aiterneng (< Aeternus; fused Latin Aeternus / Sinitic Aiteng) - Highest Heaven, the source of the Mandate and the law; revered above all when Lawful, served-not-petitioned when Neutral",
    "worship_by_alignment": {
      "Lawful": "revere the One (Aiterneng) and the Lawful powers (Tulin, Orlanus, Numengus, Gaidunus), demonize the Chaotic demon-marshals (Maraluo, Wucidus, Lusanus)",
      "Neutral": "all powers ambivalent; foreground the deified ancestors (the ancestral hall and the Divi) and the local earth-and-grain powers"
    }
  },
