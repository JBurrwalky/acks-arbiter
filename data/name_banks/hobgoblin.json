      "Gul-Maraqus": "a notched cleaver crossed with a banner-pole",
      "War-Banner Beast": "a fanged beast on an iron standard"
    },
    "race_totem": "the War-Banner Beast (Milkkar-behtark) / the Iron Order",
    "shaman_rites": "war-rites at the standard and the skull-helm; the drilling of the host before the totem; blood on the banner.",
    "tribal_totem_pattern": "[Milkkar-/Dammar-/Iron-] + [war-beast or weapon]: Milkkar-behtark (War-Beast), Dammar-shentar (Blood-Fang Standard).",
    "venerated": {
      "Maraxus (war, conquest)": "Gul-Maraqus (the great War-Spirit; supreme)",
      "Raptis (the disciplined hunt)": "Gul-Raptu (the Conquest-Hunt)",
      "Vacidus (the void)": "Gul-Waqidu (the Devouring-Dark)"
    }
  },
