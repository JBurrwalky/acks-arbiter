  "religion": {
    "_note": "Deity-names are morphs of the Agrippan canon - Celtic (Goidelic) reflexes PRIMARY (family_celtic theonym_set, reflexed through Insular-Celtic phonology), Akkadian variants SECONDARY (the family_near_eastern / hammuran morphs), never real Celtic/Mesopotamian gods. All three alignments: the Gaelic war-oath and druid-lore order meets the Akkadian law-stele and temple tradition.",
    "clergy_ladder": {
      "1": "Cill-gilla (temple-servant) / Eribbiti",
      "3": "Drui (priest)",
      "5": "Sangu (city-priest) / Naomh-drui",
      "7": "Ard-drui (high priest) / Urigallu",
      "9": "Ollam-drui (eldest sage-priest) / Shatammu (temple-primate)"
    },
    "demon_epithet_pattern": "the Chaotic powers, warded as fomori (Gaelic demon-host) or -lemnu (Akkadian evil), keep their morphs + an epithet: Maraxus -> Maragan the War-Brand (Akk Marakshu the City-Burner); Vacidus -> Faicid the Unmaker (Akk Bakidu-lemnu); Lusanto -> Losand the Hoard-Worm.",
    "holy_symbol_motifs": {
      "Gaian": "the alluvial field beneath the ziggurat",
      "Orlann": "an iron sword crossed with the city-standard",
      "Toran": "a sun-wheel over a crossed sword and law-stele"
    },
    "religious_orders_pattern": "the Nemed (Gaelic sacred grove) or Bit-ili (Akkadian god-house) of [power]: 'the Nemed of Toran', 'the Bit-ili of Tullaru'; the Gaelic substrate keeps Cill- (church/cell): 'Cill-Toran'.",
    "saints_pattern": "the sinser (the deified war-dead of the ruling cland) and the deified law-givers of the cities, honored at the carn (cairn), the nemed-grove and the ziggurat.",
