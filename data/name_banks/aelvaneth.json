  "titles": {
    "_tiers_note": "Smooth Aelvaneth reflexes of the Proto-Elvish title ladder, ascending. Veluth (lord) barony; Maeron (march-warden) march; Eskel (vale-lord) county; Thalion (great-lord) duchy; Aranel (sovereign-lord) principality; Tharan (king) kingdom; Tar-Tharan (high-king) empire. A golden-age realm, mostly fallen to fastness-enclaves. (These title-roots are the elder ancestors of the human Germanic/Celtic/Slavic lord/king terms.)",
    "female_forms": {
      "Aranel": "Araniel",
      "Eskel": "Eskeliel",
      "Maeron": "Maeriel",
      "Tar-Tharan": "Tar-Tharniel",
      "Thalion": "Thaliel",
      "Tharan": "Tharniel",
      "Veluth": "Veluthiel"
    },
    "government": "feudal (an ancient woodland realm of elder-houses, now mostly forest-fastnesses; the Tharan over the elven lords, the song-keepers and the warden-archers)",
