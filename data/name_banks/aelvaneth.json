  "religion": {
    "_note": "Deity-names are the Aelvaneth (smooth) reflexes of the Proto-Elvish theonym roots (family_elvish.json) - the eldest forms of the Agrippan canon, never real gods; they carry the sacred GENDERED ending -aron (masc) / -arien (fem) - the divine class, distinct from mortal -ion/-iel and common-noun -ath. The Aelvaneth are predominantly Lawful (weights L70/N20/C10), though a realm can seed or drift to Neutral or Chaotic; the worship/demonize set follows the realm's CURRENT alignment (see worship_by_alignment). The nemreth (star-grove) under the silver trees is the altar; the edhrath (ancestral dead) and the forest-spirits are ever-honored.",
    "clergy_ladder": {
      "1": "Edhel-dil (novice-devotee)",
      "3": "Galadhron (grove-keeper)",
      "5": "Linthir (song-and-lore keeper)",
      "7": "Airedhel (high keeper)",
      "9": "Tar-Linthir (the realm's high song-keeper)"
    },
    "demon_epithet_pattern": "the demonized set (by current alignment) take epithets: when Lawful - Maraxus -> Marakharon the Ruin; when Chaotic - Tulrius -> Tularon the Cold-Star, Aeternus -> Aiternaron the Long-Tyrant.",
    "holy_symbol_motifs": {
      "Gaianaron": "a great tree rooted in the green earth",
      "Realtarien": "a moon-star above the healing-spring",
      "Tularon": "a rayed star above the silver leaf"
    },
    "religious_orders_pattern": "the Nemreth (star-grove) of [power]: 'the Nemreth of Tularon', under the silver trees.",
    "saints_pattern": "the elder-fathers and song-makers of the houses (the edhrath), honored at the grove and the white-stone.",
    "sample_deity_renames": {
      "Gaiandus": "Gaianaron (the enduring forest-earth; Lawful power)",
      "Maraxus": "Marakharon (the war-fire, the ruin; Chaotic power)",
      "Realta": "Realtarien (the mother, the mercy-star; Neutral-honored)",
      "Tulrius": "Tularon (the sun and just light; Lawful power)"
    },
    "the_one": "Aiternaron (< Proto-Elvish AtyarnA < Aeternus; the Star-Kindler, the Eldest; sacred-masculine ending -aron; revered when Lawful, set aside when Neutral, named the Long-Tyrant when Chaotic)",
    "worship_by_alignment": {
      "Chaotic": "the fallen houses venerate the Chaotic powers (Marakharon the war-fire, Wakidaron the void, Lusanaron), demonize the Lawful powers and the One",
      "Lawful": "the high-elven court reveres the One (Aiternaron) and the Lawful powers (Tularon, Orlandaron, Gaianaron, Numenaron), demonize the Chaotic powers",
      "Neutral": "both sets ambivalent; foreground the edhrath (ancestral dead), the star-light and the forest-spirits"
    }
  },
