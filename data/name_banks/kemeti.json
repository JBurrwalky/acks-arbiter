  "religion": {
    "_note": "Deity-names are second-order phoneme-morphs: the canonical Agrippan pantheon as morphed into Punic (Barcan) trade-forms, then drifted again through Egyptian phonology (l->r; v->w; -us/-a -> -aa/-et; dj/tj/kh) with a Ge'ez monastic coloring \u2014 never real Egyptian, Nubian, or Ethiopian holy names. Lawful/Neutral; a solar divine-kingship cult with a strong funerary and monastery (debr) overlay.",
    "clergy_ladder": {
      "1": "Wab (purification-priest/acolyte)",
      "3": "Hem-netjer (god's-servant/priest)",
      "5": "Hem-netjer Tepy (high priest)",
      "7": "Memhir-Debr (monastery-master, Ge'ez overlay)",
      "9": "Hem-netjer Aa (great prophet)"
    },
    "demon_epithet_pattern": "each opposing power (the Chaotic 13 for this Lawful-leaning realm) keeps its morphed name + its own portfolio epithet (distinct per power; framed as kin of the great serpent Hefau): Maraxus -> Marakhej the City-Burner; Lusanto -> Lusandja the Coin-Serpent; Vacidus -> Wakedja the Devouring Hefau.",
    "holy_symbol_motifs": {
      "Riarath": "a sheltering vulture-mother over the ankh",
      "Tjulraa": "sun-disc above the feather of right-order"
    },
    "religious_orders_pattern": "the Per-netjer (god's-house/temple) or Debr (monastery, Ge'ez overlay) of [power]: 'the Per-netjer of Tjulraa'.",
    "saints_pattern": "the deified-just dead (akhu) and god-kings, plus Ge'ez-style monastery saints (Qiddus [name]), venerated at tomb-temples and rock-hewn debr.",
    "sample_deity_renames": {
      "Argentus": "Argandja (trade and the city)",
      "Orlandus": "Warlandja (iron-sworn)",
      "Realta": "Riarath (the mother)",
      "Tulrius": "Tjulraa (sun and right-order)"
    },
    "the_one": "Atjaraa (< Punic Atharon < Aeternus; the hidden distant maker)"
  },
