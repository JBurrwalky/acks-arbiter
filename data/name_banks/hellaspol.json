  "religion": {
    "_note": "Deity-names are phoneme-morphs of the canonical (Agrippan) pantheon through Hellenic phonology (-os/-on/-es; th/ph/kh) - recognizably the same powers, never real Greek gods.",
    "clergy_ladder": {
      "1": "Neokoros (temple-keeper)",
      "3": "Hiereus (priest)",
      "5": "Archiereus (high priest)",
      "7": "Hierophant",
      "9": "Megas Hierophant"
    },
    "demon_epithet_pattern": "each opposing power keeps its morphed name + a portfolio epithet (the suffix -daimon may mark a demon), distinct per power: Maraxus -> Maraxos the Tyrant-Flame; Dementus -> Dementhos the Mad; Desoria -> Desorios the Drowner.",
    "holy_symbol_motifs": {
      "Orlandros": "iron spear crossed with an oath-ring",
      "Tulrios": "radiate sun above olive-branch and scales"
    },
    "religious_orders_pattern": "the Mysteria/Temenos of [power]: 'the Mysteries of Numenos'.",
    "saints_pattern": "Heros [name] (deified hero/founder), venerated at a heroon (tomb-shrine).",
    "sample_deity_renames": {
      "Numeno": "Numenos (wisdom-lord)",
      "Numia": "Numios (of the sea)",
      "Orlandus": "Orlandros (iron-sworn)",
      "Tulrius": "Tulrios (sun-justice)"
    },
    "the_one": "Aiternos (< Aeternus; the One, unknowable source, honored not petitioned)",
    "worship_by_alignment": {
      "Chaotic": "Venerates the Chaotic powers of the canon, and names the Lawful powers - and Aiternos - as the tyrant-gods to be defied.",
      "Lawful": "venerates the Lawful powers - Aiternos honored above all, Tulrios the just, Orlandros of the sworn oath, Numenos of wisdom - upholding the laws of the polis and the temenos; names the Chaotic powers daimones (demons), warded.",
      "Neutral": "the ancestral heroes (the Heroes of the founding house, venerated at the heroon) and the city-daimones of hearth and harbor; the great powers invoked at the temenos situationally."
    }
  },
