      "3": "Qesis-preost (priest)",
      "5": "Qomos-massere (mass-priest)",
      "7": "Episcop (bishop)",
      "9": "Abun-aerce (metropolitan)"
    },
    "demon_epithet_pattern": "the demonized set (by current alignment) take dread epithets: when Lawful - Maraxus -> Maraxen the War-Fire; when Chaotic - Tulrius -> Thalros the Cold-Sun, Aeternus -> Aethyarn the Far Tyrant.",
    "holy_symbol_motifs": {
      "Aethyarn": "an all-seeing eye above the amba-fastness",
      "Thalros": "a rayed sun above the tablets and the cross-staff",
      "Worland": "an iron spear crossed with an oath-ring"
    },
    "religious_orders_pattern": "the Bet-mynster (church-minster) of [power]: 'the Bet-mynster of Thalros'; the amba-grove keeps the older rite.",
    "saints_pattern": "Qiddus/Halig [name] - the deified-just dead, royal saints and church-founders, kept in the recital and at the rock-hewn debr-mynster.",
    "sample_deity_renames": {
      "Maraxus": "Maraxen (the war-fire; Chaotic power)",
      "Orlandus": "Worland (the iron-oath, war; Lawful power)",
      "Realta": "Riyalda (the mother, mercy; Neutral-honored)",
      "Tulrius": "Thalros (sun and right-order; Lawful power)"
    },
    "the_one": "Aethyarn (< Aeternus; fused Ge'ez Atyarna / OE Aetern) - God Most High; revered as the supreme maker when Lawful, set aside when Neutral, reviled as the far tyrant when Chaotic",
    "worship_by_alignment": {
      "Chaotic": "venerate the Chaotic powers (the war-fire Maraxen and the wild hall-frenzy), demonize the Lawful powers and the One",
      "Lawful": "revere the One (Aethyarn) and the Lawful powers (Thalros, Worland, Geyandos, Numanos), demonize the Chaotic powers (Maraxen, Waecidos, Lusanden)",
