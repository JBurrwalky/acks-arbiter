    "sample_deity_renames": {
      "Dementus": "Tamawios (the storm-thunder; Chaotic power)",
      "Maraxus": "Maraksios (the war-fire, the raid; Chaotic power)",
      "Orlandus": "Orlantos (the iron-oath, war; Lawful power)",
      "Tulrius": "Toravios (the sun, the just light; Lawful power)"
    },
    "the_one": "Aiterunos (< Aeternus; fused Hellenic Aiternos / Plains Ateruna) - the Sky-Eternal over the grass-sea; revered when Lawful, reviled as the cold tyrant when Chaotic",
    "worship_by_alignment": {
      "Chaotic": "venerate the Chaotic powers (Maraksios the war-fire, Tamawios the storm, the raid-frenzy of the mystery-rite), demonize the Lawful powers and the One",
