  "religion": {
    "_note": "Tlanec uses the Nahuatl divine-names primarily, with the Maya names as the older substrate register (court-Nahua / folk-Maya) - the same shared pantheon under two name-sets, never real Meso gods. The Plumed-Serpent (the feathered serpent) is the dynastic KINGSHIP-symbol and Toltec legitimacy, NOT a god. Tlanec seeds/shifts Lawful, Neutral, or Chaotic; its stance follows its CURRENT alignment (see worship_by_alignment).",
    "clergy_ladder": {
      "1": "Tlamacazton (novice)",
      "3": "Tlamacazqui / Ah-k'in (priest)",
      "5": "Teopixqui (god-guardian)",
      "7": "Tlenamacac (fire-offering priest)",
      "9": "Hueyi Teopixqui (great priest)"
    },
    "demon_epithet_pattern": "the demonized set (by current alignment) take dread epithets: when Lawful - Maraxus -> Marakatl the Flayer; when Chaotic - Tulrius -> Tolratl the Cold-Sun, Aeternus -> Aiternatl the Tyrant-Sun.",
    "holy_symbol_motifs": {
      "Marakatl": "an obsidian knife over a blood-eagle",
      "Tolratl": "a sun-disc above the calendar-round",
      "the Plumed Serpent": "a feathered serpent coiled about the throne (the Toltec kingship-sign, not a god)"
    },
    "religious_orders_pattern": "the Teocalli (Nahua) or K'uh-nah (Maya) atop the pyramid of [power]: 'the Teocalli of Tolratl', 'the K'uh-nah of Tulax'.",
    "saints_pattern": "the Plumed-Serpent dynasts, deified rulers and fallen warriors, honored at the teocalli and the ancestral tomb.",
    "sample_deity_renames": {
      "Maraxus": "Marakatl / Maya Marakab (the war-fire; Chaotic power)",
      "Numeno": "Numenatl / Maya Numench (sky-wisdom; Lawful power)",
      "Realta": "Rialtzin / Maya Ix Rialtaj (the mother; Neutral-honored)",
      "Tulrius": "Tolratl / Maya Tulax (sun and law; Lawful power)"
    },
    "the_one": "Aiternatl (< Aeternus; Maya substrate: Aj Ternaj) - the One; revered as supreme Giver-of-Life when Lawful, set aside when Neutral, reviled as the tyrant-sun when Chaotic",
    "worship_by_alignment": {
      "Chaotic": "venerate the Chaotic powers (Marakatl, Wakitl, Lusankoatl), demonize the Lawful powers and the One",
      "Lawful": "revere the One (Aiternatl) and the Lawful powers (Tolratl, Orlantzin, Numenatl, Gaiantli), demonize the Chaotic",
      "Neutral": "all powers ambivalent - somewhat honored, somewhat feared; foreground the achtontli (ancestral dead), the day-lords and local spirits"
    }
  },
