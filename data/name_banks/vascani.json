    "religious_orders_pattern": "the Harrespil (stone-circle) and Nemeton (oak-grove) of [power], and the Frankish Munstar: 'the Harrespil of Caiandos', 'the Munstar of Giando'.",
    "saints_pattern": "ancestral hillfort-heroes of the etxe and the mountain, plus Frankish-overlay royal saints (Wih [name]), honored at the harrespil and the burial-cairn.",
    "sample_deity_renames": {
      "Gaiandus": "Caiandos (Frk. Giando) - the enduring mountain, foremost of the Vascani powers; Lawful",
      "Maraxus": "Maraxos (Frk. Marach) - the war-fire; Chaotic power, demonized",
      "Orlandus": "Orlanno (Frk. Erlant) - the iron-oath (and the famed Basque iron); Lawful",
      "Realta": "Rialta (Frk. Rialda) - the mother, the hearth; Neutral-honored"
    },
    "the_one": "Aiternos (< Aeternus; Frankish variant Aiterno) - the high maker, the sky over the peaks; revered when Lawful, set aside when Neutral",
    "worship_by_alignment": {
      "Lawful": "revere the One (Aiternos) and the Lawful powers (Caiandos the mountain, Orlanno the iron-oath, Numench), demonize the Chaotic powers",
      "Neutral": "all powers ambivalent; foreground the asaba (ancestral dead), the mountain- and oak-spirits, and the harrespil rites"
    }
