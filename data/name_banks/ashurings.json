      "male": [
        "s",
        "um"
      ]
    },
    "patronymic_form": "the Germanic ruling house keeps a dithematic lineage-name and -ingos; the Akkadian populace keep the 'mar-' (son of) patronymic and theophoric constructs; the throne fuses both - a thiudans who also carries a Bit- house-name.",
    "toponymic_suffixes": [
      "Bit-",
      "Dur-",
      "Kar-",
      "Til-",
      "heim",
      "burg"
    ]
  },
  "patterns": {
    "dungeons_ruins": "buried ziggurats and fallen Germanic burgs: 'the Ziggurat of Dur-[name]', 'the Sunken Ekallu', 'the Howe of the Theudings'",
