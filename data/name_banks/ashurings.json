    "ships": "river-barges and war-keels: 'Pride of the Naru', 'the Iron Boar', 'Boat of Thulrs'",
    "taverns": "'The [Adjective] [Noun]': 'The Lapis Cup', 'The Boar and Stele'"
  },
  "race": "human",
  "religion": {
    "_note": "Deity-names are morphs of the Agrippan canon - Gothic Germanic reflexes PRIMARY (family_germanic theonym_ancestors, the gothic column), Akkadian variants SECONDARY (the family_near_eastern / hammuran morphs), never real Germanic/Mesopotamian gods. Alignment PROVISIONAL (Lawful/Neutral): the Germanic war-oath order meets the Akkadian law-stele tradition.",
    "clergy_ladder": {
      "1": "Alhs-skalks (temple-servant) / Eribbiti",
      "3": "Gudja (priest)",
      "5": "Sangu (city-priest) / Weiha-gudja",
      "7": "Ufar-gudja (high priest) / Urigallu",
      "9": "Sinista-gudja (eldest priest) / Shatammu (temple-primate)"
    },
    "demon_epithet_pattern": "the Chaotic powers, warded as skohsla (Gothic demons) or -lemnu (Akkadian evil), keep their morphs + an epithet: Maraxus -> Marahs the War-Brand (Akk Marakshu the City-Burner); Vacidus -> Wakiths the Unmaker (Akk Bakidu-lemnu); Lusanto -> Lusanths the Hoard-Worm.",
    "holy_symbol_motifs": {
      "Erlands": "an iron sword crossed with the city-standard",
      "Gauands": "the alluvial field beneath the ziggurat",
      "Thulrs": "a sun-disc over a crossed sword and law-stele"
    },
    "religious_orders_pattern": "the Alhs (Germanic grove-temple) or Bit-ili (Akkadian god-house) of [power]: 'the Alhs of Thulrs', 'the Bit-ili of Tullaru'.",
    "saints_pattern": "the Anses (the deified war-dead of the ruling house) and the deified law-givers of the cities, inscribed on the stele and honored at the howe and the ziggurat.",
