  "religion": {
    "_note": "Deity-names are phoneme-morphs of the canonical (Agrippan) pantheon through Egyptian phonology (l -> r; v -> w; -us/-a -> -aa/-et; dj/tj/kh flavor) \u2014 recognizably the same powers, never real Egyptian gods. Neutral/Chaotic; strong funerary cult and god-king ideology.",
    "clergy_ladder": {
      "1": "Wab (purification-priest/acolyte)",
      "3": "Hem-netjer (god's-servant/priest)",
      "5": "Hem-netjer Sen-nu (second prophet)",
      "7": "Hem-netjer Tepy (first prophet/high priest)",
      "9": "Hem-netjer Aa (great prophet)"
    },
    "demon_epithet_pattern": "each opposing power keeps its morphed name + its own portfolio epithet (distinct per power; framed as -kin of the great serpent Hefau): Maraxus -> Marakhu the City-Burner; Raptis -> Rapetj the Red; Vacidus -> Wakedjet, the Devouring Hefau.",
    "holy_symbol_motifs": {
      "Djeroraa": "crook and flail over a tomb-pylon",
      "Tjuraa": "sun-disc above the feather of right-order"
    },
    "religious_orders_pattern": "the Per-netjer (god's-house/temple) of [power]: 'the Per-netjer of Tjuraa'.",
    "saints_pattern": "the deified dead (akhu) and god-kings, venerated at tomb-temples; 'the justified [name]' (maa-kheru).",
    "sample_deity_renames": {
      "Delorum": "Djeroraa (lord of the peaceful dead)",
      "Raptis": "Rapetj (the red hunter)",
      "Realta": "Riaret (the mother)",
      "Tulrius": "Tjuraa (sun and right-order)"
    },
    "the_one": "Atjernaa (< Aeternus; the hidden distant maker, honored not petitioned)"
  },
