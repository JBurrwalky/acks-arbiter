  "religion": {
    "_note": "Deity-names are second-order phoneme-morphs: the canonical Agrippan pantheon as morphed into Punic (Barcan) trade-forms, then drifted again through Akkadian phonology with an Egyptian solar-funerary coloring - never real Mesopotamian or Egyptian gods. Lawful/Neutral/Chaotic; a law-stele cult over a solar and tomb-cult overlay.",
    "clergy_ladder": {
      "1": "Eribbiti (temple-enterer)",
      "3": "Sangu (priest)",
      "5": "Shangu Rabu (high priest)",
      "7": "Urigallu (chief priest)",
      "9": "Shatammu (temple-primate)"
    },
    "demon_epithet_pattern": "each opposing power (the Chaotic 13 for this Lawful-leaning realm) keeps its morphed name + its own portfolio epithet (distinct per power; '-lemnu' = evil may be appended): Maraxus -> Marakshu the City-Burner; Lusanto -> Lusantu the Coin-Serpent; Vacidus -> Wakidu the Devourer.",
    "holy_symbol_motifs": {
      "Rialtu": "a sheltering disc-and-crescent above the mother-throne",
      "Tulrishu": "winged sun-disc over a law-stele"
    },
    "religious_orders_pattern": "the Bit-ili / Per-netjer (god-house/temple) of [power]: 'the Bit-ili of Tulrishu'.",
    "saints_pattern": "deified law-givers and the justified dead, on the temple-stele and in tomb-chapels; 'the Just [name]'.",
    "sample_deity_renames": {
      "Argentus": "Arganzu (trade and the city)",
      "Orlandus": "Urlanzu (iron-sworn)",
      "Realta": "Rialtu (the mother)",
      "Tulrius": "Tulrishu (sun and judgment)"
    },
    "the_one": "Atharnu (< Punic Atharon < Aeternus; the great distant maker, honored through His ministers)",
    "worship_by_alignment": {
      "Chaotic": "Venerates the Chaotic powers of the canon (the Coin-Serpent, the City-Burner, the Devourer), and names the Lawful powers - and Atharnu - as the distant tyrant-makers to be defied; the law-stele is a thing to be broken.",
      "Lawful": "venerates the Lawful powers - Atharnu the distant maker, Tulrishu the just-judge of the law-stele, Urlanzu of the sworn iron, Rialtu the merciful mother - inscribed on the stele and honored in the sun-temple; the Chaotic powers are named -lemnu (evil) and warded.",
      "Neutral": "the justified dead and the ancestral law-givers (the deified Just) and the city-spirits of the Bit-ili / Per-netjer; the great powers invoked at temple and tomb-chapel situationally."
    }
  },
  "schema_version": 1,
