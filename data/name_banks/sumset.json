      "1": "Eribbiti (temple-enterer)",
      "3": "Sangu (priest)",
      "5": "Shangu Rabu (high priest)",
      "7": "Urigallu (chief priest)",
      "9": "Shatammu (temple-primate)"
    },
    "demon_epithet_pattern": "each opposing power (the Chaotic 13 for this Lawful-leaning realm) keeps its morphed name + its own portfolio epithet (distinct per power; '-lemnu' = evil may be appended): Maraxus -> Marakshu the City-Burner; Lusanto -> Lusantu the Coin-Serpent; Vacidus -> Wakidu the Devourer.",
    "holy_symbol_motifs": {
      "Rialtu": "a sheltering disc-and-crescent above the mother-throne",
      "Tulrishu": "winged sun-disc over a law-stele"
    },
    "religious_orders_pattern": "the Bit-ili / Per-netjer (god-house/temple) of [power]: 'the Bit-ili of Tulrishu'.",
    "saints_pattern": "deified law-givers and the justified dead, on the temple-stele and in tomb-chapels; 'the Just [name]'.",
    "sample_deity_renames": {
      "Argentus": "Arganzu (trade and the city)",
      "Orlandus": "Urlanzu (iron-sworn)",
      "Realta": "Rialtu (the mother)",
