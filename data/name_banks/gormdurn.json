  "race": "dwarf",
  "religion": {
    "_note": "Deity-names are the Gormdurn reflexes of the Dwarven morphs of the Agrippan canon (family_dwarven.json) - never real dwarf-gods; sacred ending -drumm (masc) / -drumma (fem). ANCESTOR-CENTRIC like all dwarves (daily prayer to the durnad and fadrun at the tomb-hall), but the Gormdurn lean hardest into FIRE: the forge (Orlunndrumm) and, in the Chaotic fire-cult, the forge-fire/volcano power Marakkadrumm - honored with HUMAN SACRIFICE cast into the volcanoes. The drumgrund and the caldera's edge are both altars.",
    "clergy_ladder": {
      "1": "Drok-kun (novice, the hammer-bearer)",
      "3": "Fadrun-warden (keeper of the ancestor-tombs)",
      "5": "Gorm-drumm (fire-priest of the caldera)",
      "7": "Bral-drumm (high forge-priest)",
      "9": "Dur-Drumm (the realm's high priest)"
    },
    "demon_epithet_pattern": "the demonized set (by current alignment): when Chaotic (the fire-cult) - Aeternus -> Atrunndrumm the Cold-Vault; when Lawful - Maraxus -> Marakkadrumm the Devourer, Lusanto -> Lusunndrumm the Gold-Sickness.",
    "holy_symbol_motifs": {
      "Gundunndrumm": "a peak above crossed picks",
      "Marakkadrumm": "a flame rising from a cleft mountain",
      "Orlunndrumm": "a hammer crossed over an anvil"
    },
    "religious_orders_pattern": "the Drumgrund (festival-hall) or the caldera-rite of [power]: 'the Gorm-Drumgrund of Marakkadrumm', loud with hammers and the offering-fires.",
    "saints_pattern": "the honored forefathers and master-smiths of the clans (the durnad), and, in the fire-cult, the great sacrificers, named at hearth, tomb, and pyre.",
    "sample_deity_renames": {
      "Gaiandus": {
        "gloss": "the mountain, the mine, the deep earth; honored, masc.",
        "primary": "Gundunndrumm",
        "primary_family": "dwarven"
      },
      "Maraxus": {
        "gloss": "the forge-fire and the volcano; the fire-cult's power, fed with human sacrifice; Chaotic, masc.",
        "primary": "Marakkadrumm",
        "primary_family": "dwarven"
      },
      "Orlandus": {
        "gloss": "the forge, the smith, oaths and iron; most honored god, masc.",
        "primary": "Orlunndrumm",
        "primary_family": "dwarven"
      },
      "Realta": {
        "gloss": "the hearth-mother, mercy; honored, fem.",
        "primary": "Reltaddrumma",
        "primary_family": "dwarven"
      }
    },
    "the_one": "Atrunndrumm (< Aeternus; sacred-masc -drumm; the Stone-Father, the First Shaper; honored at festivals, distant from daily prayer; named the Cold-Vault by the fire-cult)",
    "worship_by_alignment": {
      "Chaotic": "the fire-cult (strong here): venerate Marakkadrumm the forge-fire/volcano with HUMAN SACRIFICE in the volcanoes, and Lusunndrumm the gold-sickness; demonize the One (Atrunndrumm the Cold-Vault) and the Lawful powers",
      "Lawful": "the orderly minority revere the One (Atrunndrumm) and the Lawful powers (Orlunndrumm the smith, Gundunndrumm the mountain), demonize the Chaotic fire-cult",
      "Neutral": "the dwarven norm: daily prayer to the honored dead (durnad) and clan-fathers (fadrun); the gods at yearly/seasonal festivals, foremost the forge (Orlunndrumm) and the mountain/mine (Gundunndrumm); the volcano-fire (Marakkadrumm) honored AND feared, fed offerings at the caldera"
    }
  },
