  "religion": {
    "_note": "Deity-names are fused morphs of the Agrippan canon (Celtic + Japonic), never real Celtic/Japanese gods. Shidhean seeds/shifts Lawful or Chaotic; its stance follows its CURRENT alignment (see worship_by_alignment). The powers are met at the grove-shrine (nemiya) and the misted peak; the spirit-keepers (fused druid-and-shrine-priest) mediate, and the honored ancestral dead are kept at the clan-shrine.",
    "clergy_ladder": {
      "1": "Drui-deshi (lore-novice)",
      "3": "Druikannushi (grove-priest)",
      "5": "Faithnegi (seer-priest)",
      "7": "Ardruikan (arch-keeper)",
      "9": "Ollamguji (supreme sage-keeper)"
    },
    "demon_epithet_pattern": "the demonized set (by current alignment) take dread epithets: when Lawful - Maraxus -> Maratake the War-Flame, Vacidus -> Faikido the Unmaker; when Chaotic - Tulrius -> Toranshi the Cold-Light, Aeternus -> Eterami the Far Tyrant.",
    "holy_symbol_motifs": {
      "Gaiwane": "a mist-wreathed grey peak over a torii",
      "Realhime": "a moon-mirror above a healing-spring",
      "Toranshi": "a sun-wheel above crossed oak and pine"
    },
    "religious_orders_pattern": "the Nemiya (grove-shrine) of [power] on the misted slope: 'the Nemiya of Toranshi', within its torii-arch and sacred grove.",
    "saints_pattern": "the Tuath-kami (the god-kin and grove-spirits) and the ancestral heroes of the finuji, enshrined at the clan-shrine and the holy peak.",
    "sample_deity_renames": {
      "Gaiandus": "Gaiwane (the enduring rock-mountain; Lawful power)",
      "Maraxus": "Maratake (the war-flame, the spirit-frenzy; Chaotic power)",
      "Realta": "Realhime (the mercy-mother; Neutral-honored)",
      "Tulrius": "Toranshi (the sun, the shining order; Lawful power)"
    },
    "the_one": "Eterami (< Aeternus; fused Celtic Eternan / Japonic Takami) - the Ancient-Above, the sky over the misted peaks; revered when Lawful, set aside when Chaotic",
    "worship_by_alignment": {
      "Chaotic": "venerate the Chaotic powers (Maratake the war-flame, the wild grove-frenzy), demonize the Lawful powers and the One",
      "Lawful": "revere the One (Eterami) and the Lawful powers (Toranshi, Orhagane, Gaiwane, Num-ami), demonize the Chaotic powers (Maratake, Faikido, Losankr)",
      "Neutral": "Honors the ancestral dead and the local powers of hearth, grove and land; the great powers of the canon are invoked situationally rather than worshipped whole."
    }
  },
