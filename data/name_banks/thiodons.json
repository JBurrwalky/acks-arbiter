  "religion": {
    "_note": "Deity-names are the Gothic-branch reflexes of the common-Germanic theonym ancestors (family_germanic.json theonym_ancestors, the gothic column) - phoneme-morphs of the Agrippan canon, never real Germanic gods. All three alignments present: Lawful kin keep the high oath-and-sun powers, Chaotic kin the wolf-and-fire powers, Neutral kin the ancestral war-dead and the earth-and-grove powers; the One is distant.",
    "clergy_ladder": {
      "1": "Gudja-magus (priest-novice)",
      "3": "Gudja (priest)",
      "5": "Auhuma-gudja (high priest)",
      "7": "Weiha (sanctifier)",
      "9": "Reiks-gudja (priest-lord)"
    },
    "demon_epithet_pattern": "the opposing powers keep their Gothic reflexes + a portfolio epithet (distinct per power): Maraxus -> Marahs the War-Fire; Vacidus -> Wakiths the Unmaker; Lusanto -> Lusanths the Hoard-Worm.",
    "holy_symbol_motifs": {
      "Erlands": "an iron spear crossed with an oath-ring",
      "Thulrs": "a rayed sun-wheel above the scales"
    },
    "religious_orders_pattern": "the Alhs (temple / sacred grove) of [power]: 'the Alhs of Erlands'.",
    "saints_pattern": "the Anses (deified forebears) honored at the grave-howe; 'the Blessed [name]'.",
    "sample_deity_renames": {
      "Gaiandus": "Gauands (the enduring earth)",
      "Numeno": "Numins (the storm-mind, sky-wisdom)",
      "Orlandus": "Erlands (the iron-oath, war)",
      "Realta": "Riala (the mother, mercy)",
      "Tulrius": "Thulrs (sun and judgment)"
    },
    "the_one": "Aiterns (< *Aiternaz < Aeternus; the distant All-Father, seldom petitioned)",
    "worship_by_alignment": {
      "Chaotic": "Venerates the Chaotic powers of the canon - the wolf-and-fire kin keep Marahs the War-Fire and the wild powers - and names the Lawful powers, and Aiterns, as the binding-gods to be defied.",
      "Lawful": "venerates the Lawful powers - Aiterns, Thulrs the just, Erlands of the sworn war, Riala the merciful - and names the Chaotic powers skohsla (demons), warded; the war-oath binds and the high gods uphold the kin.",
      "Neutral": "the ancestral war-dead (the Anses of the kin) and the earth-and-grove powers - Gauands of the enduring land, the spirits of the alhs-grove - the great powers invoked situationally as the season and the deed require."
    }
  },
