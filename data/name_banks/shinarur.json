  "religion": {
    "_note": "Deity-names are phoneme-morphs of the canonical (Agrippan) pantheon through Akkadian phonology (-us/-ius -> -u/-ishu; o -> u; v -> b; doubling) - recognizably the same powers, never real Mesopotamian gods. All three alignments.",
    "clergy_ladder": {
      "1": "Eribbiti (temple-enterer)",
      "3": "Sangu (priest)",
      "5": "Shangu Rabu (high priest)",
      "7": "Urigallu (chief priest)",
      "9": "Shatammu (temple-primate)"
    },
    "demon_epithet_pattern": "each opposing power keeps its morphed name + its own portfolio epithet (distinct per power; the suffix '-lemnu' = evil may be appended): Maraxus -> Marakshu the City-Burner; Irantius -> Irantishu the Restless; Vacidus -> Bakidu-lemnu (the Unmaking).",
    "holy_symbol_motifs": {
      "Numunu": "stylus on a clay tablet",
      "Tullaru": "winged sun-disc over a law-stele"
    },
    "religious_orders_pattern": "the Bit-ili (god-house/temple) of [power]: 'the Bit-ili of Tullaru'.",
    "saints_pattern": "deified law-givers and heroes inscribed on the temple-stele; 'the Just [name]'.",
    "sample_deity_renames": {
      "Argentus": "Argantu (trade and the city)",
      "Lieta": "Littu (the grain)",
      "Numeno": "Numunu (the scribe-wisdom)",
      "Tulrius": "Tullaru (sun and judgment)"
    },
    "the_one": "Itarnu (< Aeternus; the great distant one, honored not petitioned)",
    "worship_by_alignment": {
      "Chaotic": "Venerates the Chaotic powers of the canon, and names the Lawful powers - and Itarnu - as the tyrant-gods to be defied.",
      "Lawful": "venerates the Lawful powers of the canon - Itarnu the distant, Tullaru the just sun-judge, Urlandu of the sworn war, Rialtu the merciful - and names the Chaotic powers -lemnu (evil), warded by the law-stele and the temple rite",
      "Neutral": "the city-spirits and ancestral dead of the bit-ili and the family stele; the great powers invoked at the temple situationally, as the season and the need require"
    }
  },
