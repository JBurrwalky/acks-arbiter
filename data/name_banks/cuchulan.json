  "religion": {
    "_note": "Deity-names are phoneme-morphs of the Agrippan canon through Insular-Celtic phonology (family_celtic.json theonym_set) - never real Celtic gods. All three alignments: Lawful kin keep the sun-and-oath powers; Neutral the ancestral dead, the land and the nature-powers; Chaotic the war-fury and raven powers. Druidic: the drui and the fili mediate; the Tuath-de are the god-kin.",
    "clergy_ladder": {
      "1": "Drui-dalta (druid-novice)",
      "3": "Drui (druid)",
      "5": "Faith (seer-priest)",
      "7": "Ard-drui (arch-druid)",
      "9": "Ollam (supreme sage)"
    },
    "demon_epithet_pattern": "the opposing powers keep their Celtic morphs + a portfolio epithet (distinct per power): Maraxus -> Maragan the War-Fire; Vacidus -> Faicid the Unmaker; Lusanto -> Losand the Hoard-Worm.",
    "holy_symbol_motifs": {
      "Orlann": "an iron spear crossed with a torc (oath-ring)",
      "Realtan": "a star above a healing-well",
      "Toran": "a triskele sun-wheel over crossed oak"
    },
    "religious_orders_pattern": "the Nemed (sacred grove) of [power]: 'the Nemed of Toran'.",
    "saints_pattern": "the Tuath-de (the god-kin) and the ancestral heroes of the fine, honored at the cairn and the holy well; the Lawful add 'Naomh [name]' (saint).",
    "sample_deity_renames": {
      "Gaiandus": "Gaian (the enduring land)",
      "Orlandus": "Orlann (the iron-oath, battle)",
      "Realta": "Realtan (the mother, the mercy-star)",
      "Tulrius": "Toran (the sun, the just brightness)"
    },
    "the_one": "Eternan (< Aeternus; the Ancient One beyond the god-kin, seldom petitioned)"
  },
  "schema_version": 1,
  "tier": "culture",
  "titles": {
    "_tiers_note": "Insular Celtic (Gaelic) clanhold, ascending. Built on ri (king) and tuath (petty kingdom): Ri Tuaithe (king of a tuath) principality, Ruiri (over-king) kingdom, Ard-ri (high king) empire over the Ard-rige. Aire (noble) barony; Maor (warden) march; Toisech (sept-chief) county; Flaith (lord) duchy. A clan culture rarely rises past the ri-tuaithe. The brithem (judge) and fili (poet-seer) stand outside the ladder. (Rank titles are the real Gaelic register, allowed.)",
    "female_forms": {
      "Aire": "Banaire",
