  "patterns": {
    "dungeons_ruins": "drowned Greek poleis and Egyptian tomb-temples: 'the Labyrinth of Heros [name]', 'the Sunken Per-netjer'",
    "military_units": "the [Adjective] Phalanx / the [nome] Companies: 'the Bronze Phalanx', 'the Delta Companies'",
    "ships": "grain-fleet and war-galley names: 'Nike', 'Pride of Ptola', 'Barque of Tjuraa'",
    "taverns": "'The [Adjective] [Noun]': 'The Amber Kylix', 'The Golden Lotus'"
  },
  "race": "human",
  "religion": {
    "_note": "Deity-names are morphs of the Agrippan canon (Hellenic primary, from classical theonym treatment; Egyptian variant from near_eastern theonym_sets), never real Greek/Egyptian gods. The Ptolan fuse the two cults (a Serapis-style syncretism): each power has a Hellenic court-name and an Egyptian temple-name, held to be one. Ptolan seeds/shifts Lawful or Neutral; its stance follows its CURRENT alignment (see worship_by_alignment). The polis-temple and the Egyptian Per-netjer keep the rites together.",
    "clergy_ladder": {
      "1": "Neokoros (temple-keeper)",
      "3": "Hiereus (priest)",
      "5": "Archiereus (high priest)",
      "7": "Hem-netjer Tepy (first prophet, Egy overlay)",
      "9": "Megas Hierophant"
    },
    "demon_epithet_pattern": "the demonized set (the Chaotic powers, when Lawful) take dread epithets: Maraxus -> Maraxos the Tyrant-Flame (Egy. Marakhu the City-Burner); Vacidus -> Wakedjet the Devourer; Lusanto -> Lusandros the Coin-Serpent.",
    "holy_symbol_motifs": {
      "Aiternos": "the winged disc above the polis-eagle",
      "Realta": "a sheltering mother-goddess over the lotus",
      "Tulrios": "a radiate sun above the double crown"
    },
    "religious_orders_pattern": "the Temenos (sacred precinct) or Per-netjer (god's-house) of [power]: 'the Temenos of Tulrios', 'the Per-netjer of Tjuraa'.",
    "saints_pattern": "deified kings and founder-heroes (Greek Heros [name]; Egyptian the justified dead, maa-kheru), venerated at the temple and the royal tomb.",
    "sample_deity_renames": {
      "Maraxus": "Maraxos (Egy. Marakhu) - the war-fire; Chaotic, demonized",
      "Numeno": "Numenos - sky-wisdom; Lawful",
      "Realta": "Realta (Egy. Riaret) - the mother; Neutral-honored",
      "Tulrius": "Tulrios (Egy. Tjuraa) - sun and right-order; Lawful"
    },
    "the_one": "Aiternos (< Aeternus; Egyptian temple-name Atjernaa) - the One, revered as the Most High when Lawful, acknowledged but set aside when Neutral",
    "worship_by_alignment": {
      "Lawful": "revere the One (Aiternos/Atjernaa) and the Lawful powers (Tulrios, Orlandros, Numenos, Gauandos), demonize the Chaotic powers",
      "Neutral": "all powers ambivalent; foreground the deified ancestors (the justified dead) and the local temple-cults of place"
    }
  },
  "schema_version": 1,
  "tier": "culture",
  "titles": {
    "_tiers_note": "Hellenic backbone, ascending, with an Egyptian overlay at the nome and the crown. Toparch barony; Phrourarch (garrison-commander) march; Nomarch (governor of an Egyptian nome) county; Strategos (general-governor) duchy; Dynastes (prince) principality; Basileus (king) kingdom; Basileus Megas, styled Per-aa (Pharaoh) to the native temples, over the realm. The Greek court and the Egyptian priesthood share the rule. (Rank titles are the real Greek/Egyptian register, allowed.)",
    "female_forms": {
      "Basileus": "Basilissa",
      "Basileus Megas (Per-aa)": "Basilissa Megale (Per-aat)",
      "Dynastes": "Dynastissa",
