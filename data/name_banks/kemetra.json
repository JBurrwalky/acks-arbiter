  "religion": {
    "_note": "Deity-names are phoneme-morphs of the canonical (Agrippan) pantheon through Egyptian phonology (l -> r; v -> w; -us/-a -> -aa/-et; dj/tj/kh flavor) - recognizably the same powers, never real Egyptian gods. Lawful/Neutral/Chaotic; strong funerary cult and god-king ideology.",
    "clergy_ladder": {
      "1": "Wab (purification-priest/acolyte)",
      "3": "Hem-netjer (god's-servant/priest)",
      "5": "Hem-netjer Sen-nu (second prophet)",
      "7": "Hem-netjer Tepy (first prophet/high priest)",
      "9": "Hem-netjer Aa (great prophet)"
    },
    "demon_epithet_pattern": "each opposing power keeps its morphed name + its own portfolio epithet (distinct per power; framed as -kin of the great serpent Hefau): Maraxus -> Marakhu the City-Burner; Raptis -> Rapetj the Red; Vacidus -> Wakedjet, the Devouring Hefau.",
    "holy_symbol_motifs": {
      "Djeroraa": "crook and flail over a tomb-pylon",
      "Tjuraa": "sun-disc above the feather of right-order"
    },
    "religious_orders_pattern": "the Per-netjer (god's-house/temple) of [power]: 'the Per-netjer of Tjuraa'.",
    "saints_pattern": "the deified dead (akhu) and god-kings, venerated at tomb-temples; 'the justified [name]' (maa-kheru).",
    "sample_deity_renames": {
      "Delorum": {
        "gloss": "lord of the peaceful dead",
        "primary": "Djeroraa",
        "primary_family": "near_eastern"
      },
      "Raptis": {
        "gloss": "the red hunter",
        "primary": "Rapetj",
        "primary_family": "near_eastern"
      },
      "Realta": {
        "gloss": "the mother",
        "primary": "Riaret",
        "primary_family": "near_eastern"
      },
      "Tulrius": {
        "gloss": "sun and right-order",
        "primary": "Tjuraa",
        "primary_family": "near_eastern"
      }
    },
    "the_one": "Atjernaa (< Aeternus; the hidden distant maker, honored not petitioned)",
    "worship_by_alignment": {
      "Chaotic": "venerates the Chaotic powers of the canon - Rapetj the Red and the Hefau-kin - and names Tjuraa, Djeroraa and Atjernaa the order-tyrants to be defied; the funerary cult turned to the devouring serpent.",
      "Lawful": "venerates the Lawful powers - Atjernaa the hidden maker, Tjuraa of right-order (maat), Djeroraa who judges the peaceful dead, Riaret the mother - and wards the Chaotic powers as the kin of the great serpent Hefau; maat (right-order) binds god-king and commoner alike, upheld at the per-netjer.",
      "Neutral": "the deified dead (akhu) and the god-kings venerated at the tomb-temples, and the river/harvest powers of the Nile invoked situationally; the great powers honored at the per-netjer as the season and the flood require."
    }
  },
