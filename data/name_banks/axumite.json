  "religion": {
    "_note": "Deity-names are phoneme-morphs of the canonical (Agrippan) pantheon through Ge'ez phonology (emphatics; -us/-a -> -a/-os; v -> w/b) \u2014 recognizably the same powers, never real Ethiopian or Christian holy names. Lawful henotheist: the One is prominent and the Lawful powers venerated as His ministers; Neutral kin honor the saints and ancestral dead (akhu equivalents) at monastery-shrines.",
    "clergy_ladder": {
      "1": "Diyaqon (deacon-acolyte)",
      "3": "Qesis (priest)",
      "5": "Qomos (archpriest/hegumen)",
      "7": "Episqopos (bishop)",
      "9": "Abun (metropolitan)"
    },
    "demon_epithet_pattern": "each opposing power (the Chaotic 13 for this Lawful-leaning realm) keeps its morphed name + its own hostile portfolio-epithet, distinct per power, framed as the rebel hosts of the serpent-adversary: Maraxus -> Marakos the City-Burner; Vacidus -> Wak'idos the Devouring Void; Metensia -> Matansa the Wasting.",
    "holy_symbol_motifs": {
      "Gayandos": "a grey amba (table-mountain) beneath stars",
      "Talros": "a rayed sun above the tablets of right-order",
      "Warlandos": "an iron spear crossed with an oath-ring"
    },
    "religious_orders_pattern": "the Bet (temple) or Debr (monastery) of [power]: 'the Debr of Numanos'.",
    "saints_pattern": "Qiddus/Qiddist [name] (the holy [name]); the deified-just dead and god-favored kings, venerated at a debr (monastery-shrine).",
    "sample_deity_renames": {
      "Gaiandus": "Gayandos (the enduring mountain)",
      "Numeno": "Numanos (wisdom and the winds)",
      "Orlandus": "Warlandos (iron-sworn)",
      "Realta": "Riyalta (the mother / mercy)",
      "Tulrius": "Talros (sun and right-order)"
    },
    "the_one": "Atyarna (< Aeternus; God Most High, the maker, prominent and petitioned through His ministers)"
  },
  "schema_version": 1,
  "tier": "culture",
  "titles": {
    "_tiers_note": "Ge'ez/Ethiopian, ascending (barony..empire). Built on the negus root: Negus/Negusat (king/kingdom), Negusa-Nagast (king of kings, the emperor) over the Mangist (realm). Shum (chief) barony; Bahr-Negash (governor of the sea/frontier) march; Dejazmach (commander of the gate) county; Makwannen (governor) duchy; Ras (head/prince) principality. (Rank titles are the real Ethiopian register, allowed.)",
    "female_forms": {
      "Bahr-Negash": "Bahr-Negashit",
      "Dejazmach": "Dejazmachit",
      "Makwannen": "Makwannenit",
