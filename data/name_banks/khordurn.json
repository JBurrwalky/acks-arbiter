  "religion": {
    "_note": "Deity-names are the Khordurn reflexes of the Dwarven morphs of the Agrippan canon (family_dwarven.json) - never real Tolkien/Norse/Warhammer dwarf-gods; they take the sacred GENDERED ending -drumm (masc) / -drumma (fem) - the anvil-named class, distinct from mortal -un/-ar/-ok / -a/-na/-ra and the common-noun root. ANCESTOR-CENTRIC: daily liturgy and prayer go to the honored dead (the durnad) and clan-fathers (fadrun) at the tomb-hall; the gods are honored at yearly/seasonal FESTIVALS, foremost the forge (Orlundrumm) and the mine/mountain (Gundundrumm). The drumgrund (festival-hall), loud with hammers on the feast-days, is where the gods are sung.",
    "clergy_ladder": {
      "1": "Drok-kun (novice, the hammer-bearer)",
      "3": "Fadrun-warden (keeper of the ancestor-tombs)",
      "5": "Bral-drumm (forge-priest)",
      "7": "Grund-drumm (high hold-priest)",
      "9": "Dur-Drumm (the realm's high priest)"
    },
    "demon_epithet_pattern": "the demonized set (by current alignment): when Lawful - Maraxus -> Marakadrumm the Wrack, Lusanto -> Lusundrumm the Gold-Sickness; when Chaotic - Aeternus -> Atrundrumm the Cold-Vault.",
    "holy_symbol_motifs": {
      "Gundundrumm": "a peak above crossed picks",
      "Orlundrumm": "a hammer crossed over an anvil",
      "Reltadrumma": "a hearth-flame in cupped hands"
    },
    "religious_orders_pattern": "the Drumgrund (festival-hall) of [power]: 'the Drumgrund of Orlundrumm', loud with hammers on the feast-days.",
    "saints_pattern": "the honored forefathers and master-smiths of the clans (the durnad), named at every hearth and tomb.",
    "sample_deity_renames": {
      "Delorum": {
        "gloss": "death and the honored dead; the ancestor-warden, masc.",
        "primary": "Delrundrumm",
        "primary_family": "dwarven"
      },
      "Gaiandus": {
        "gloss": "the mountain, the mine, the deep earth; co-foremost, masc.",
        "primary": "Gundundrumm",
        "primary_family": "dwarven"
      },
      "Orlandus": {
        "gloss": "the forge, the smith, oaths and iron; the most honored god, masc.",
        "primary": "Orlundrumm",
        "primary_family": "dwarven"
      },
      "Realta": {
        "gloss": "the hearth-mother, mercy; honored, fem.",
        "primary": "Reltadrumma",
        "primary_family": "dwarven"
      }
    },
    "the_one": "Atrundrumm (< Aeternus; sacred-masculine ending -drumm; the Stone-Father, the First Shaper; honored at the great festivals but distant from the daily ancestor-prayers; revered most when Lawful)",
    "worship_by_alignment": {
      "Chaotic": "venerate the Chaotic fire- and greed-powers (Marakadrumm the forge-fire, Lusundrumm the gold-sickness), demonize the Lawful powers and the One",
      "Lawful": "revere the One (Atrundrumm) and the Lawful powers (Orlundrumm the smith, Gundundrumm the mountain, Numundrumm), demonize the Chaotic powers",
      "Neutral": "the dwarven norm: daily prayer to the honored dead (the durnad) and clan-fathers (fadrun) at the tomb-hall; the gods honored at yearly/seasonal festivals, foremost the forge (Orlundrumm) and the mountain/mine (Gundundrumm), the powers of fire and earth; the One and the rest acknowledged distantly"
    }
  },
