  "religion": {
    "_note": "Deity-names are the Sinitic morphs of the Agrippan canon (family_east_asian.json theonym_sets.sinitic) - never real Chinese gods. A Celestial Bureaucracy under the Mandate of Heaven: the One (Aiteng) presides as Highest Heaven; the Lawful powers are the celestial officials (-di emperors, -jun lords); the Neutral honor ancestors (the zu) and the local earth-and-grain powers. Confucian rites and ancestor-veneration order all.",
    "clergy_ladder": {
      "1": "Daoshi-tu (acolyte)",
      "3": "Daoshi (priest)",
      "5": "Fashi (ritual-master)",
      "7": "Gaogong (high priest)",
      "9": "Tianshi (celestial master)"
    },
    "demon_epithet_pattern": "the opposing powers are the demon-marshals (mo) outside the celestial order, each with an epithet: Maraxus -> Maluo the War-Fire Marshal; Vacidus -> Wuci the Devourer; Lusanto -> Lusan the Coin-Serpent.",
    "holy_symbol_motifs": {
      "Gaidun-di": "a green mountain over the grain-altar",
      "Tuli-di": "a red sun-disc above the scales and seal of office"
    },
    "religious_orders_pattern": "the Miao (temple) of [power]: 'the Miao of Tuli-di'; the ancestral Ci (clan-shrine) for the zu.",
    "saints_pattern": "deified heroes and worthy officials enrolled in the celestial register, honored at the Ci (ancestral shrine) and the Miao; 'the Lord [name]'.",
    "sample_deity_renames": {
      "Gaiandus": "Gaidun-di (the Earth Emperor, lord of mountains)",
      "Numeno": "Numeng-jun (the Sage Lord of the winds)",
      "Realta": "Lianta-mu (the Mother of Mercy)",
      "Tulrius": "Tuli-di (the Sun-Justice Emperor)"
    },
    "the_one": "Aiteng (< Aeternus; the Highest Heaven, the source of the Mandate, served not petitioned)"
  },
  "schema_version": 1,
  "tier": "culture",
  "titles": {
    "_tiers_note": "Sinitic feudal, ascending. The Huangdi (emperor) holds the Mandate of Heaven (Tianming) over the Diguo; the Wang are kings/princes; the peerage descends Gong (duke) > Hou (marquis) > Bo (count) > Nan (baron). The Dudu hold the frontier military commands (march). Three-Kingdoms flavor: contending wang and warlords beneath a weakened throne. (Rank titles are the real Chinese register, allowed.)",
