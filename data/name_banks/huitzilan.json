  "religion": {
    "_note": "Deity-names are fused morphs of the Agrippan canon (Norse + Nahuatl), never real gods. Huitzilan is Chaotic alone: a blood-cult that venerates the Chaotic powers - chief among them Marahtl, the War-Fire and Blood-Sun that must be fed - and DEMONIZES the One (Eitnatl) and the Lawful powers as the cold sky-tyrants. The frenzy of the berserker and the offered heart are one rite; the teoharg (blood-temple) atop the peak and the skull-rack are the altars.",
    "clergy_ladder": {
      "1": "Bloteppa-tzin (blood-novice)",
      "3": "Godtlama (blood-priest)",
      "5": "Tledr-godi (fire-priest)",
      "7": "Valnamac (slain-offerer)",
      "9": "Hueyblotmadr (great sacrificer)"
    },
    "demon_epithet_pattern": "the One and the Lawful powers are the enemy-gods, named with dread: Aeternus -> Eitnatl the Tyrant-Sun (the chief enemy); Tulrius -> Tholatl the Cold-Sun; Orlandus -> Orlantr the Soft-Oath; Numeno -> Numentr the Idle-Word.",
    "holy_symbol_motifs": {
      "Lusankr": "a feathered serpent coiled over a hoard",
      "Marahtl": "an obsidian-edged sword over a blood-fed sun",
      "Wakitr": "an open maw of ice swallowing a star"
    },
    "religious_orders_pattern": "the Teoharg (blood-temple) atop the tepfjall (peak) of [power], crowned by the skull-rack: 'the Teoharg of Marahtl'.",
    "saints_pattern": "fallen war-kings and the greatest reavers become sun-feeding storm-riders; honored at the skull-rack and the burial-howe.",
    "sample_deity_renames": {
      "Lusanto": "Lusankr (the hoard-serpent)",
      "Maraxus": "Marahtl (the War-Fire, the Blood-Sun that must be fed; chief of the venerated powers)",
      "Raptis": "Raptzr (the hunt, the captive-taking)",
      "Vacidus": "Wakitr (the Devourer, the hungering ice-dark)"
    },
    "the_one": "Eitnatl (< Aeternus; fused Norse Eitnir / Nahuatl Aiternatl) - REVILED as the cold Tyrant-Sun that would starve the world of blood; cursed, never revered"
  },
