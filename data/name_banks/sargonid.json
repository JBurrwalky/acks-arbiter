  "religion": {
    "_note": "Deity-names are morphs of the Agrippan canon (Akkadian primary, from near_eastern theonym_sets; Latinate canon-form as the learned variant), never real Mesopotamian/Roman gods. Sargonid is Lawful alone: the apex law-empire reveres the One (Itarnu) above His ministers and the Lawful powers as the celestial magistracy that gave the law; the Chaotic powers are the demon-marshals it exists to suppress. The law-stele and the temple-tower (ziggurat) are the altars.",
    "clergy_ladder": {
      "1": "Eribbiti (temple-enterer)",
      "3": "Sangu (priest)",
      "5": "Shangu Rabu (high priest)",
      "7": "Urigallu (chief priest)",
      "9": "Shatammu Pontifex (temple-primate)"
    },
    "demon_epithet_pattern": "the Chaotic powers are the demon-marshals the empire suppresses, each with a portfolio epithet ('-lemnu' = evil): Maraxus -> Marakshu the City-Burner; Vacidus -> Bakidu-lemnu the Unmaking; Lusanto -> Lusantu the Coin-Serpent.",
    "holy_symbol_motifs": {
      "Numunu": "stylus on a clay tablet beneath the scales",
      "Tullaru": "winged sun-disc above a law-stele",
      "Urlandu": "an iron oath-ring crossed with the legion's standard"
    },
    "religious_orders_pattern": "the Bit-ili (god-house/ziggurat) of [power]: 'the Bit-ili of Tullaru'; the law-court keeps its stele in the Latin overlay as the Curia.",
    "saints_pattern": "deified law-givers and just magistrates inscribed on the temple-stele; 'the Just [name]' / Latin 'Divus [name]'.",
    "sample_deity_renames": {
      "Argentus": "Argantu (trade and the city; Lawful)",
      "Numeno": "Numunu (the scribe-wisdom, keeper of the code; Lawful)",
      "Orlandus": "Urlandu (the iron-oath, war; Lawful)",
      "Tulrius": "Tullaru (sun and judgment, lord of the law-stele; Lawful)"
    },
    "the_one": "Itarnu (< Aeternus; Latinate variant Aeternus - the supreme Lawgiver of Heaven, source of the Mandate of order, revered above all)"
  },
  "schema_version": 1,
  "tier": "culture",
  "titles": {
    "_tiers_note": "Akkadian backbone, ascending, with a Latinate administrative overlay. Hazannu (mayor) barony; Massaru (warden) march, over a Latin-styled Limis (frontier); Shaknu (appointed governor) county, ruling a Praefectura; Turtanu (commander-in-chief) duchy; Rubu (prince) principality; Sharru (king) kingdom; Shar-kishshati (king of the totality), styled in the Latin overlay Imperator, over the Kishshatu. The legions (Legio) and the law-code (the dinu) are the empire's spine. (Rank titles are the real Akkadian/Latin register, allowed.)",
    "female_forms": {
      "Hazannu": "Hazannatu",
      "Massaru": "Massartu",
      "Rubu": "Rubatu",
      "Shaknu": "Shaknatu",
      "Shar-kishshati Imperator": "Sharrat-kishshati Imperatrix",
      "Sharru": "Sharratu",
      "Turtanu": "Turtanutu"
    },
    "government": "feudal (a law-empire: the Sharru-Imperator over the peerage and the Confucian-strict magistracy; the law-code and the legions sustain the order)",
