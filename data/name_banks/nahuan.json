  "religion": {
    "_note": "Deity-names are the Nahuatl morphs of the Agrippan canon (family_mesoamerican.json theonym_sets.nahuatl) - never real Aztec gods (no Quetzalcoatl, Tezcatlipoca, Huitzilopochtli, Tlaloc, Xipe Totec). Shared pantheon, Nahuan names. Nahuan is Chaotic alone: a blood-cult empire that venerates the Chaotic powers - chief among them Marakatl, the War-Fire / the Blood-Sun that must be fed by sacrifice - and DEMONIZES the One (Aiternatl) and the Lawful powers as the cold tyrants of the soft. The calendar-round and the offered heart bind the people to the powers; the teocalli (pyramid-temple) and the skull-rack are the altars.",
    "clergy_ladder": {
      "1": "Tlamacazton (novice)",
      "3": "Tlamacazqui (priest)",
      "5": "Teopixqui (god-guardian)",
      "7": "Tlenamacac (fire-and-blood offering priest)",
      "9": "Hueyi Teopixqui (great sacrificer)"
    },
    "demon_epithet_pattern": "the One and the Lawful powers are the enemy-gods, named with dread: Aeternus -> Aiternatl the Tyrant-Sun (the chief enemy); Tulrius -> Tolratl the Cold-Sun; Orlandus -> Orlantzin the Soft-Oath; Numeno -> Numenatl the Idle-Scribe.",
    "holy_symbol_motifs": {
      "Lusankoatl": "a coiled serpent over a heap of jade",
      "Marakatl": "an obsidian knife over a blood-fed sun",
      "Wakitl": "an open maw swallowing a star"
    },
    "religious_orders_pattern": "the Teocalli (god-house) atop the great pyramid of [power]: 'the Teocalli of Marakatl', crowned by the skull-rack.",
    "saints_pattern": "fallen warriors and offered captives become sun-feeding companions and hummingbird-spirits; the conqueror-tlatoque honored at the teocalli and the skull-rack.",
    "sample_deity_renames": {
      "Lusanto": "Lusankoatl (the hoard-serpent)",
      "Maraxus": "Marakatl (the War-Fire, the Blood-Sun that must be fed; chief of the venerated powers)",
      "Raptis": "Raptzin (the hunt, the captive-taking)",
      "Vacidus": "Wakitl (the Devourer, the hungering dark)"
    },
    "the_one": "Aiternatl (< Aeternus; the One, REVILED as the Tyrant-Sun - the cold sky that would starve the world of blood; cursed, never revered)"
  },
  "schema_version": 1,
  "tier": "culture",
  "titles": {
    "_tiers_note": "Aztec civ, ascending. Built on tlatoani (speaker/ruler): Tlatoani (city-king of an altepetl) duchy; Hueyi Tlatoani (great speaker, emperor) kingdom; Cem-Anahuac Tlatoani (ruler of all the world) empire. Tecuhtli (lord) barony; Tlacatecuhtli (war-chief) march; Tecpantlatoani (governor) county; Tlatocatecuhtli (over-king) principality. The pipiltin nobility, the calpolli wards and the war-cult sustain the realm. (Rank titles are the real Nahuatl register, allowed.)",
    "female_forms": {
