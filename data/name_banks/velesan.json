    },
    "religious_orders_pattern": "the Kapishche (idol-shrine) of [power]: 'the Kapishche of Tulor', set with carved idoly in the sacred grove.",
    "saints_pattern": "the Dedy (ancestral dead) and the rod-spirits honored at the kurgan (grave-mound) and the hearth; the Lawful-leaning add 'the Blessed [name]'.",
    "sample_deity_renames": {
      "Gaiandus": "Goyan (the enduring earth)",
