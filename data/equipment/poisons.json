{
  "version": 1,
  "description": "Monster venoms and plant toxins. Source: acore_aging_poisons_high-level-start_optional_rules.xml (Layer 1, sacred). All costs in copper pieces: 1gp=100cp. save_modifier: positive = bonus to saving throw (easier to resist); negative = penalty (harder to resist).",
  "extraction_rules": {
    "monster_venom": "Extraction requires 1 day + Animal Husbandry proficiency throw 11+. Unmodified roll of 1 = extractor is scratched and must save vs Poison as if struck by the monster. One dose = enough for 20 missiles or 1 melee weapon. Weapon-applied venom is less effective than natural delivery.",
    "plant_toxin": "Gathering requires Naturalism proficiency at the listed throw. Extraction requires 1 week + Alchemy proficiency throw 14+ (fresh plant) or 17+ (dried plant). Unmodified roll of 1 on either throw = extractor is exposed and must save vs Poison. One dose = enough for 20 missiles or 1 melee weapon (injury delivery), or poisons one meal/drink (ingestion delivery)."
  },
  "evaporation_rules": {
    "day_1": "Full damage and effect.",
    "day_2": "Half damage. +2 bonus to saving throw for deadly poisons.",
    "day_3": "Poison evaporated, no effect. +4 bonus to saving throw for deadly poisons still active on day 2.",
    "melee_weapon": "Each hit counts as one day of evaporation (half damage on 2nd hit, gone after 2nd hit).",
    "self_injury": "Unmodified attack roll of 1 = pricked by own poisoned weapon; must save vs Poison."
  },
