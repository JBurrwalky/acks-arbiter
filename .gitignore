# Godot 4 — generated caches and editor state (do not commit)
.godot/

# Godot import metadata (auto-regenerated from source assets)
*.import

# Godot export artefacts
export/
*.pck
*.exe
*.x86_64
*.arm64
*.apk
*.aab
*.ipa

# Godot UID metadata (auto-generated, not meaningful source)
*.uid

# godot-sqlite temp/lock files
~lib*.dll

# OS junk
.DS_Store
Thumbs.db
*.tmp
*~

# SQLite runtime databases (generated at runtime in user://)
# These live outside the project folder in the OS user data dir,
# so nothing to ignore here — but keep this note for reference.

# Agent worktrees (claude-code parallel runs)
.claude/worktrees/

# Large generated/media video files — exceed GitHub's 100MB push limit; keep out of git.
*.avi
*.mp4
*.mov
*.mkv

# Headless test-run log — regenerated by tools/run_tests.ps1 on every suite run
/headless_test_run.log
