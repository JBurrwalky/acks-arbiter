      </power>

      <power name="nonaggressive" custom_power_value="-1">
        <rule>Noncombatant has never had to kill or be killed.</rule>
        <penalty type="damage_rolls" scope="missile_and_melee_weapons" value="-1"/>
      </power>

      <power name="uncertain" custom_power_value="-1">
        <rule>Noncombatant lacks the situational awareness and intensity of focus that keeps an adventurer alive.</rule>
