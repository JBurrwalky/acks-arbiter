<acks_summary title="noncombatant_characters" summary_scope="rules, procedures, definitions, tables" flavor_excluded="true">
  <document_scope>
    <rule>Summarizes the noncombatant subtype for characters, rules for becoming a combatant, and listed noncombatant monster statistics.</rule>
    <rule>Noncombatant is a subtype applicable to characters of any class or race, not a standalone class.</rule>
  </document_scope>

  <noncombatant_subtype>
    <identity>
      <name>noncombatant_subtype</name>
      <applies_to>any character of any class or race</applies_to>
      <category>class_adjacent_subtype</category>
    </identity>

    <definition>
      <rule>A noncombatant is a character not devoted to adventure, combat, and exploration.</rule>
      <rule>Any class or race may be treated as a noncombatant.</rule>
      <rule>Noncombatants advance in level more quickly than comparable combatants.</rule>
      <rule>Noncombatants suffer substantial combat, durability, and aging penalties.</rule>
    </definition>

    <xp_progression_rules>
      <rule>The base cost of advancing from 1st level to 2nd level is decreased by 800 XP.</rule>
      <rule>The decreased base cost doubles thereafter through 8th level.</rule>
      <rule>At 9th level and above, the base cost is decreased by 50,000 XP per level.</rule>
    </xp_progression_rules>

