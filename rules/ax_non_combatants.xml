            <value name="cumulative_adjustments">-2 STR, -2 DEX, -3 CON</value>
          </row>
          <row>
            <value name="age_category">Old</value>
            <value name="progressive_adjustments">-3 STR, -2 DEX, -2 CON, -2 CHA</value>
            <value name="cumulative_adjustments">-5 STR, -4 DEX, -5 CON, -2 CHA</value>
          </row>
          <row>
            <value name="age_category">Ancient</value>
            <value name="progressive_adjustments">-2 STR, -3 DEX, -2 CON, -4 CHA</value>
            <value name="cumulative_adjustments">-7 STR, -7 DEX, -7 CON, -4 CHA</value>
          </row>
        </table>
      </power>

      <power name="tender" custom_power_value="-10">
        <rule>Noncombatant has never been hardened by suffering and injury.</rule>
        <rule>Begins play with one-half normal hit points, excluding CON bonus.</rule>
        <rule>Gains one less hit point each level thereafter.</rule>
      </power>
    </custom_powers>
