    <core_statistics>
      <hit_die>1d8</hit_die>
      <maximum_level>14</maximum_level>
      <baseline_title>Hunter</baseline_title>
      <post_max_hit_dice_rule>After 9d8 hit dice, gains +2 hit points per additional level; printed hit dice progression is 9d8+2*, 9d8+4*, 9d8+6*, 9d8+8*, 9d8+10*.</post_max_hit_dice_rule>
      <general_notes>
        <rule>At 1st level, hits AC 0 on 10+.</rule>
        <rule>Attack throws and saving throws improve by 2 points every 3 levels.</rule>
        <rule>Base damage bonus progression is +1 at 1st level and increases by an additional +1 at 3rd, 6th, 9th, and 12th level.</rule>
      </general_notes>
