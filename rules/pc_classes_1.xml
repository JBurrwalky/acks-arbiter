    <core_statistics>
      <hit_die>1d6</hit_die>
      <maximum_level>14</maximum_level>
      <baseline_title>Miscreant</baseline_title>
      <post_max_hit_dice_rule>After 9d6 hit dice, gains +2 hit points per additional level; printed hit dice progression is 9d6+2*, 9d6+4*, 9d6+6*, 9d6+8*, 9d6+10*.</post_max_hit_dice_rule>
      <general_notes>
        <rule>At 1st level, hits AC 0 on 10+.</rule>
        <rule>Attack throws and saving throws improve by 2 points every 3 levels.</rule>
        <rule>Base damage from missile and melee attacks is +1 at 1st level and increases by an additional +1 at 3rd, 6th, 9th, and 12th level.</rule>
      </general_notes>
    </core_statistics>

    <combat_profile>
      <permissions>
        <armor>Any armor.</armor>
        <shields>May use shields.</shields>
        <weapons>
          <rule>Permitted weapons: battle axe, dagger, flail, mace, morning star, pole arm, short sword, spear, sword, two-handed sword, whip.</rule>
        </weapons>
        <fighting_styles>
          <rule>Permitted fighting styles: weapon and shield, two-handed weapon, two weapons.</rule>
        </fighting_styles>
      </permissions>
      <restrictions>
        <restriction>None beyond listed weapon permissions and Chaotic alignment requirement.</restriction>
      </restrictions>
      <combat_rules>
        <rule>May use any magic item usable by fighters.</rule>
      </combat_rules>
    </combat_profile>

    <class_subsystems>
      <turning>
        <definition>Undead command ability.</definition>
        <rules>
          <rule>Commands undead as a Chaotic cleric of half the anti-paladin's level, rounded up.</rule>
        </rules>
      </turning>

      <custom_subsystem name="proficiency_access">
        <definition>Class proficiency list.</definition>
        <rules>
          <rule>Available proficiencies: Alertness, Ambushing, Berserkergang, Blind Fighting, Combat Reflexes, Combat Trickery (force back, incapacitate, overrun, sunder), Command, Divine Blessing, Dungeon Bashing, Endurance, Fighting Style, Intimidation, Illusion Resistance, Kin-Slaying, Knowledge (history), Leadership, Manual of Arms, Martial Training, Military Strategy, Mystic Aura, Profession (torturer), Riding, Running, Theology, Weapon Focus.</rule>
        </rules>
      </custom_subsystem>
    </class_subsystems>

    <special_abilities>
      <ability name="aura_of_protection" level="1">
        <summary>Receives defensive bonuses against good creatures.</summary>
        <rules>
          <rule>Gains +1 bonus to AC against attacks made by good creatures.</rule>
          <rule>Gains +1 bonus on saving throws against effects created by good creatures.</rule>
          <rule>For the anti-paladin's aura and detection abilities, good creatures include creatures of Lawful alignment and Neutral creatures with good intentions.</rule>
          <rule>Pinnacles of good and magic items harmful to creatures of Chaotic alignment are also detected by these powers.</rule>
          <rule>The aura appears as a writhing tenebrous shroud when viewed with detect evil, detect magic, or true seeing.</rule>
        </rules>
      </ability>

      <ability name="detect_good" level="1">
        <summary>Can detect good by concentration.</summary>
        <rules>
          <rule>Can detect good as the reversed form of detect evil.</rule>
          <rule>Range is up to 60'.</rule>
          <rule>Each use requires concentration and takes 1 turn.</rule>
        </rules>
      </ability>

      <ability name="alignment_betrayal_consequences" level="1">
        <summary>Changing alignment causes loss of class powers.</summary>
        <triggers>
          <trigger>The anti-paladin changes alignment to Neutral or Lawful.</trigger>
        </triggers>
        <rules>
          <rule>Loses class powers.</rule>
          <rule>If later reverting to Chaotic alignment and atoning for misdeeds, possibly through a dire quest or an atonement spell, lost powers can be regained.</rule>
          <rule>An anti-paladin who became Lawful may be permitted to become a paladin at the Judge's discretion.</rule>
          <rule>A lawful turncoat anti-paladin will be hunted.</rule>
        </rules>
      </ability>

      <ability name="death_knight_advancement" level="1">
        <summary>Can continue class advancement after becoming intelligent undead.</summary>
        <rules>
          <rule>If the anti-paladin becomes intelligent undead, whether by patron reward or by personal effort, the anti-paladin can continue to advance in this class as per the Zaharan's after the flesh power.</rule>
          <rule>Such undead anti-paladins are called Death Knights.</rule>
        </rules>
      </ability>

      <ability name="unholy_fanaticism" level="5">
        <summary>Improves morale of certain hirelings.</summary>
        <rules>
          <rule>Hirelings of the same religion as the anti-paladin gain +1 morale whenever the anti-paladin is present.</rule>
          <rule>This bonus stacks with modifiers from Charisma or proficiencies.</rule>
        </rules>
      </ability>

      <ability name="dark_fortress" level="9">
        <summary>May establish a stronghold and attract followers.</summary>
        <rules>
          <rule>May found or capture a dark fortress.</rule>
          <rule>The dark fortress is otherwise identical to a fighter's castle.</rule>
        </rules>
        <outcomes>
          <outcome>When the fortress is established, up to 1d4+1x100 0th level mercenaries and 1d6 anti-paladins of 1st-3rd level come to apply for jobs and training.</outcome>
          <outcome>If hired, these followers must be paid standard mercenary rates.</outcome>
        </outcomes>
      </ability>
    </special_abilities>

