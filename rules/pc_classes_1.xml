        <ability>STR</ability>
        <ability>CHA</ability>
      </prime_requisites>
      <minimum_abilities/>
      <entry_restrictions>
        <restriction type="requirements">none</restriction>
        <restriction type="alignment">Must be Chaotic.</restriction>
      </entry_restrictions>
