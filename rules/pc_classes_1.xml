    <combat_profile>
      <permissions>
        <armor>Chain mail or lighter armor.</armor>
        <shields>May use shields when permitted by selected fighting style.</shields>
        <weapons>
          <rule>Permitted weapons are determined by selected regional origin.</rule>
        </weapons>
        <fighting_styles>
          <rule>Permitted fighting styles are determined by selected regional origin.</rule>
        </fighting_styles>
      </permissions>
      <restrictions>
        <restriction>Limited to the traditional weapons and fighting styles of the selected tribe or region of origin.</restriction>
      </restrictions>
      <combat_rules>
        <rule>At 1st level, choose either melee attacks or missile attacks for the class damage bonus progression.</rule>
        <rule>The chosen attack type receives the barbarian's class damage bonus at all levels.</rule>
        <rule>The choice cannot be changed after character creation.</rule>
        <rule>May use magic items usable by fighters.</rule>
      </combat_rules>
    </combat_profile>

    <class_subsystems>
      <custom_subsystem name="regional_origin">
        <definition>Each barbarian selects a regional origin at character creation which determines permitted weapons, permitted fighting styles, and a bonus natural proficiency.</definition>
        <rules>
          <rule>At character creation, select a region of origin from the regional origin table and record the permitted weapons and fighting styles.</rule>
          <rule>The listed natural proficiency is a bonus proficiency and does not count against the barbarian's normal selections.</rule>
          <rule>The Judge may create additional regions of origin and corresponding natural proficiencies for the campaign setting.</rule>
        </rules>
        <procedure>
          <step order="1">Choose a region of origin when the barbarian is created.</step>
          <step order="2">Record the weapons permitted by that region.</step>
          <step order="3">Record the fighting styles permitted by that region.</step>
          <step order="4">Gain the listed natural proficiency as a bonus proficiency.</step>
        </procedure>
        <tables>
          <table name="regional_origin">
            <columns>
              <column>region</column>
              <column>natural_proficiency</column>
              <column>weapons_permitted</column>
              <column>fighting_styles_permitted</column>
            </columns>
            <row>
              <value name="region">Jutland</value>
              <value name="natural_proficiency">Climbing</value>
              <value name="weapons_permitted">Battle axe, club, dagger, great axe, hand axe, shortbow, spear, sword, two-handed sword, war hammer</value>
              <value name="fighting_styles_permitted">Weapon &amp; shield, two-handed weapon</value>
            </row>
            <row>
              <value name="region">Skysostan</value>
              <value name="natural_proficiency">Precise Shooting</value>
              <value name="weapons_permitted">Composite bow, dagger, hand axe, javelin, lance, net, sling, short sword (scimitar), spear, whip</value>
              <value name="fighting_styles_permitted">Weapon &amp; shield, two weapons</value>
            </row>
            <row>
              <value name="region">Ivory Kingdoms</value>
              <value name="natural_proficiency">Running</value>
              <value name="weapons_permitted">Bola, club, dart, dagger, hand axe, javelin, net, shortbow, short sword, spear</value>
              <value name="fighting_styles_permitted">Weapon &amp; shield, two weapons</value>
            </row>
          </table>
        </tables>
      </custom_subsystem>

      <custom_subsystem name="proficiency_access">
        <definition>Class proficiency list.</definition>
        <rules>
          <rule>Available proficiencies: Alertness, Ambushing, Armor Training, Beast Friendship, Berserkergang, Blind Fighting, Climbing, Combat Reflexes, Combat Trickery (force back, knock down, overrun, wrestling), Command, Endurance, Fighting Style, Martial Training, Mountaineering, Passing Without Trace, Precise Shooting, Riding, Running, Seafaring, Skirmishing, Sniping, Survival, Swashbuckling, Weapon Finesse, Weapon Focus.</rule>
        </rules>
      </custom_subsystem>
    </class_subsystems>

    <special_abilities>
      <ability name="damage_specialization_choice" level="1">
        <summary>Class damage bonus applies to either melee or missile attacks, chosen at 1st level.</summary>
        <rules>
          <rule>Choose melee attacks or missile attacks at 1st level.</rule>
          <rule>The class damage bonus applies only to the chosen attack type.</rule>
          <rule>The choice cannot be changed as the barbarian advances.</rule>
        </rules>
      </ability>

      <ability name="animal_reflexes" level="1">
        <summary>Improves initiative and surprise.</summary>
        <rules>
          <rule>Gains +1 bonus to initiative.</rule>
          <rule>Gains +1 bonus to surprise rolls.</rule>
        </rules>
      </ability>

      <ability name="natural_stealth" level="1">
        <summary>Harder to surprise and easier to ambush with.</summary>
        <rules>
          <rule>Opponents suffer a -1 penalty to surprise rolls when encountering the barbarian.</rule>
        </rules>
      </ability>

      <ability name="savage_resilience" level="1">
        <summary>Improves Mortal Wounds outcomes and recovery time.</summary>
        <rules>
          <rule>Whenever required to consult the Mortal Wounds table, the player rolls twice and chooses the preferred result.</rule>
          <rule>Subtract class level from the number of days of bed rest required to recover.</rule>
        </rules>
      </ability>

      <ability name="animal_magnetism" level="5">
        <summary>Improves morale of followers when personally led.</summary>
        <rules>
          <rule>Henchmen and mercenaries hired by the barbarian gain +1 morale whenever the barbarian personally leads them.</rule>
          <rule>This bonus stacks with modifiers from Charisma or proficiencies.</rule>
        </rules>
      </ability>

      <ability name="chieftains_hall" level="9">
        <summary>May establish a hall and attract followers.</summary>
        <rules>
          <rule>May build or claim a chieftain's hall.</rule>
          <rule>The hall is otherwise identical to a fighter's castle.</rule>
        </rules>
        <outcomes>
          <outcome>When the hall is established, 1d4+1x100 0th level mercenaries join service.</outcome>
