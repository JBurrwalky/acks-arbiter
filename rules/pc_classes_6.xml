    <stronghold_and_followers>
      <unlock_level>9</unlock_level>
      <structure_type>monastery</structure_type>
      <acquisition_rules>
        <rule>Upon reaching 9th level (Enlightened Master), a mystic can establish a monastery and assume a place of temporal power in society.</rule>
        <rule>Mystics' monasteries are otherwise identical to clerics' fortified churches.</rule>
      </acquisition_rules>
      <followers>
        <follower type="soldiers_0th_level" number="5d6x10"/>
        <follower type="mystics_1st_to_3rd_level" number="1d6"/>
      </followers>
      <cost_rules>
        <rule>Followers are completely loyal (morale +4).</rule>
        <rule>Followers must be provided food and lodging but need not be paid wages.</rule>
      </cost_rules>
    </stronghold_and_followers>

