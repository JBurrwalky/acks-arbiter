  <class name="Zaharan Ruinguard">
    <identity>
      <name>Zaharan Ruinguard</name>
      <ancestry_category default="human">human (Zaharan bloodline)</ancestry_category>
      <source_label>111-ACKS Players Companion-Classes.md</source_label>
    </identity>

    <classification>
      <role_tags>
        <tag>warrior</tag>
        <tag>sorcerer_knight</tag>
        <tag>chthonic_caster</tag>
      </role_tags>
      <capability_tags>
        <tag>fighter_progression</tag>
        <tag>arcane_casting_in_armor</tag>
        <tag>fear_immunity</tag>
        <tag>arcane_striking</tag>
        <tag>death_healing</tag>
        <tag>spell_storing</tag>
        <tag>full_armor</tag>
        <tag>stronghold</tag>
      </capability_tags>
    </classification>

    <requirements>
      <prime_requisites>
        <ability>STR</ability>
        <ability>INT</ability>
      </prime_requisites>
      <minimum_abilities>
        <ability name="INT">9</ability>
        <ability name="WIS">9</ability>
        <ability name="CHA">9</ability>
      </minimum_abilities>
      <entry_restrictions>
        <restriction type="requirements">INT, WIS, and CHA of 9 or greater.</restriction>
      </entry_restrictions>
    </requirements>

    <progression_mapping>
      <primary_progression_family>fighter</primary_progression_family>
      <attack_throw_progression family="fighter"></attack_throw_progression>
      <saving_throw_progression family="fighter_plus_dark_blessing">Saves improve 2 points every 3 levels (fighter family). The +2 universal bonus from dark blessing is already factored into printed save values.</saving_throw_progression>
      <damage_bonus_progression family="ruinguard_custom">+1 at 1st level, +1 more at 3rd, 6th, 9th, and 12th (maximum +5 at 12th). Applies only to melee attacks with permitted weapons.</damage_bonus_progression>
    </progression_mapping>

    <core_statistics>
      <hit_die>1d6</hit_die>
      <maximum_level>12</maximum_level>
      <baseline_title>Insignificant</baseline_title>
      <post_max_hit_dice_rule>After 9d6 hit dice, gains +2 hit points per additional level; printed progression at levels 10-12 is 9d6+2*, 9d6+4*, 9d6+6*. Constitution modifiers are ignored on the +2 post-max HD entries.</post_max_hit_dice_rule>
      <general_notes>
        <rule>At 1st level, hits AC 0 on 10+.</rule>
        <rule>Attack throws and saving throws improve by 2 points every 3 levels of experience (fighter family).</rule>
        <rule>Base damage from successful melee attacks with permitted weapons increases by +1 at 1st level, and by an additional +1 at 3rd, 6th, 9th, and 12th level.</rule>
      </general_notes>
    </core_statistics>

    <combat_profile>
      <permissions>
        <armor>Any armor; generally favors the heaviest available.</armor>
        <shields>May use shields.</shields>
        <weapons>
          <rule>Permitted weapons: sword, two-handed sword, battle axe, great axe, flail, whip.</rule>
        </weapons>
        <fighting_styles>
          <rule>Permitted fighting styles: weapon and shield, two-handed weapon.</rule>
        </fighting_styles>
      </permissions>
      <restrictions>
        <restriction>Chthonic powers disdain ranged attacks; ruinguards have no ranged weapons in their permission list.</restriction>
      </restrictions>
      <combat_rules>
        <rule>May use any magic item available to mages or fighters.</rule>
        <rule>May cast arcane spells while wearing any type of armor.</rule>
      </combat_rules>
    </combat_profile>

    <class_subsystems>
      <arcane_casting>
        <definition>Learns and casts arcane spells as a mage of one-half class level, using the same spell list and repertoire rules.</definition>
        <rules>
          <rule>Effective caster level = floor(class_level / 2).</rule>
          <rule>Spell selection uses the mage arcane spell list and mage repertoire rules.</rule>
          <rule>May cast spells in any armor.</rule>
        </rules>
      </arcane_casting>
      <custom_subsystem name="proficiency_access">
        <definition>Class proficiency list.</definition>
        <rules>
          <rule>Available proficiencies: Alertness, Ambushing, Battle Magic, Berserkergang, Black Lore of Zahar, Blind Fighting, Combat Trickery (force back, knock down, overrun, sunder), Command, Dungeon Bashing, Elementalism, Endurance, Familiar, Fighting Style, Intimidation, Kin-Slaying, Leadership, Manual of Arms, Military Strategy, Mystic Aura, Sensing Good, Sensing Power, Siege Engineering, Skirmishing, Theology, Unflappable Casting, Wakefulness, Weapon Focus.</rule>
        </rules>
      </custom_subsystem>
    </class_subsystems>

    <special_abilities>
      <ability name="dark_blessing" level="1">
        <summary>+2 bonus to all saving throws (already factored into printed saves).</summary>
      </ability>
      <ability name="quickening" level="1">
        <summary>+1 bonus to surprise rolls and initiative rolls.</summary>
      </ability>
      <ability name="weapon_focus_chosen" level="1">
        <summary>At character creation, choose one weapon type from: battle axe, great axe, flail, sword, two-handed sword, whip. The ruinguard is considered to possess weapon focus while wielding the chosen weapon type.</summary>
      </ability>
      <ability name="ancient_pacts" level="1">
        <summary>+2 bonus to reaction rolls when encountering intelligent chaotic monsters. Intelligent chaotic monsters suffer -2 on saving throws against charm spells cast by the ruinguard.</summary>
      </ability>
      <ability name="inexorable" level="1">
        <summary>Immune to all natural and magical fear effects.</summary>
      </ability>
      <ability name="after_the_flesh" level="1">
        <summary>If transformed into intelligent undead, retains racial powers and class abilities and may continue to advance in Hit Dice past the class's maximum level.</summary>
        <rules>
          <rule>A 1 HD undead ruinguard requires 4,000 XP to advance to 2 HD; XP cost doubles with each HD thereafter (round values greater than 20,000 XP to the nearest 1,000).</rule>
          <rule>Class abilities continue to progress without regard to the class maximum level, up to a maximum of 14th level.</rule>
        </rules>
      </ability>
      <ability name="dark_soul" level="1">
        <summary>On the Tampering With Mortality table, suffers a -1 penalty to the 1d20 roll per level of experience.</summary>
      </ability>
      <ability name="bonus_languages" level="1">
        <summary>Speaks four bonus languages: Ancient Zaharan, Goblin, Orc, and Kemeshi.</summary>
      </ability>
      <ability name="arcane_striking" level="2">
        <summary>On a successful melee hit, may expend one daily spell slot to increase damage by 1d6 per level of the spell slot expended.</summary>
      </ability>
      <ability name="death_healing" level="4">
        <summary>On a melee kill of a sentient creature, may (in lieu of cleaving) expend a spell slot to heal self 1d6 per level of the spell slot expended, up to the slain victim's maximum (starting) hit points.</summary>
      </ability>
      <ability name="dark_charisma" level="5">
        <summary>Any chaotic characters or monsters in the ruinguard's service gain +1 morale when personally led by the ruinguard. Stacks with Charisma or proficiency modifiers.</summary>
      </ability>
      <ability name="spell_storing" level="9">
        <summary>May cast a creature-targeting spell into the melee weapon, where it remains stored until discharged on the next creature struck. Only one spell may be stored at a time; discharges harmlessly if not used within 1 turn, if the weapon is sundered, or if the ruinguard loses his grip on the weapon.</summary>
      </ability>
      <ability name="dark_fortress" level="9">
        <summary>May build a dark fortress. Otherwise identical to a fighter's castle.</summary>
        <outcomes>
          <outcome>Attracts up to 1d4+1x100 0th level mercenaries and 1d6 ruinguards of 1st-3rd level seeking jobs and training.</outcome>
          <outcome>If hired, followers must be paid standard mercenary rates.</outcome>
        </outcomes>
      </ability>
      <ability name="spell_research" level="10">
        <summary>At 10th level (Lord of Secrets), may research spells, scribe magical scrolls, and brew potions as if a 5th level mage.</summary>
      </ability>
    </special_abilities>

