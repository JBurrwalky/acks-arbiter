  <class name="Nobiran Wonderworker">
    <identity>
      <name>Nobiran Wonderworker</name>
      <ancestry_category default="human">human (Nobiran bloodline)</ancestry_category>
      <source_label>111-ACKS Players Companion-Classes.md</source_label>
    </identity>

    <classification>
      <role_tags>
        <tag>arcane_caster</tag>
        <tag>divine_caster</tag>
        <tag>healer</tag>
      </role_tags>
      <capability_tags>
        <tag>mage_progression</tag>
        <tag>arcane_repertoire</tag>
        <tag>divine_casting_cleric_list</tag>
        <tag>lay_on_hands</tag>
        <tag>ageless</tag>
        <tag>disease_immunity</tag>
        <tag>ghoul_paralysis_immunity</tag>
        <tag>stronghold_sanctum</tag>
      </capability_tags>
    </classification>

    <requirements>
      <prime_requisites>
        <ability>INT</ability>
        <ability>WIS</ability>
      </prime_requisites>
      <minimum_abilities>
        <ability name="STR">11</ability>
        <ability name="INT">11</ability>
        <ability name="WIS">11</ability>
        <ability name="DEX">11</ability>
        <ability name="CON">11</ability>
        <ability name="CHA">11</ability>
      </minimum_abilities>
      <entry_restrictions>
        <restriction type="requirements">All six ability scores must be 11+.</restriction>
      </entry_restrictions>
    </requirements>

    <progression_mapping>
      <primary_progression_family>mage</primary_progression_family>
      <attack_throw_progression family="mage"></attack_throw_progression>
      <saving_throw_progression family="mage_plus_dark_blessing">Saves improve 2 points every 6 levels (mage family). The +2 universal bonus from the favored of the Empyrean powers is already factored into printed save values.</saving_throw_progression>
    </progression_mapping>

    <core_statistics>
      <hit_die>1d4</hit_die>
      <maximum_level>12</maximum_level>
      <baseline_title>Divine Arcanist</baseline_title>
      <post_max_hit_dice_rule>After 9d4 hit dice, gains +1 hit point per additional level; printed progression at levels 10-12 is 9d4+1*, 9d4+2*, 9d4+3*.</post_max_hit_dice_rule>
      <general_notes>
        <rule>At 1st level, hits AC 0 on 10+.</rule>
        <rule>Attack throws and saving throws improve by 2 points every 6 levels of experience (mage family).</rule>
      </general_notes>
    </core_statistics>

    <combat_profile>
      <permissions>
        <armor>None. No armor of any kind.</armor>
        <shields>None.</shields>
        <weapons>
          <rule>Permitted weapons: quarterstaff, club, dagger, dart.</rule>
        </weapons>
        <fighting_styles>
          <rule>No fighting styles; may not fight with two weapons.</rule>
        </fighting_styles>
      </permissions>
      <combat_rules>
        <rule>May use any magic item usable by mages.</rule>
      </combat_rules>
    </combat_profile>

    <class_subsystems>
      <arcane_casting>
        <definition>Learns and casts arcane spells as a mage (same repertoire rules).</definition>
        <rules>
          <rule>Repertoire size equals the number and level of spells listed for his level, increased by Intelligence bonus.</rule>
          <rule>Spell selection is limited to spells in the wonderworker's repertoire.</rule>
          <rule>Uses the arcane spell list.</rule>
        </rules>
      </arcane_casting>
      <divine_casting>
        <definition>Beginning at 2nd level (Divine Seer), may manifest deity's power in the form of divine spells.</definition>
        <rules>
          <rule>Divine spells are granted through prayer and worship (cleric-style, not repertoire).</rule>
          <rule>Uses the cleric divine spell list.</rule>
        </rules>
      </divine_casting>
      <custom_subsystem name="proficiency_access">
        <definition>Class proficiency list.</definition>
        <rules>
          <rule>Available proficiencies: Apostasy, Battle Magic, Beast Friendship, Collegiate Wizardry, Command, Contemplation, Craft, Diplomacy, Elementalism, Familiar, Healing, Illusion Resistance, Knowledge, Language, Laying on Hands, Leadership, Loremastery, Magical Engineering, Martial Training, Mystic Aura, Naturalism, Prestidigitation, Profession, Prophecy, Quiet Magic, Sensing Evil, Sensing Power, Theology, Transmogrification, Unflappable Casting.</rule>
        </rules>
      </custom_subsystem>
    </class_subsystems>

    <special_abilities>
      <ability name="favored_of_empyrean_powers" level="1">
        <summary>+2 bonus to all saving throws (already factored into printed saves).</summary>
      </ability>
      <ability name="ageless" level="1">
        <summary>Lifespan three times longer than that of normal men; does not age normally.</summary>
      </ability>
      <ability name="ghoul_paralysis_immunity" level="1">
        <summary>Immune to ghoul paralysis (as elves).</summary>
      </ability>
      <ability name="divine_health" level="1">
        <summary>Immune to all forms of disease, including magical diseases caused by spells, mummies, or lycanthropes.</summary>
      </ability>
      <ability name="lay_on_hands" level="1">
        <summary>Heals 2 hit points per class level when used; usable once per day. Additional uses may be gained via the Laying on Hands proficiency.</summary>
      </ability>
      <ability name="blood_of_ancient_kings" level="1">
        <summary>May hire one more henchman than Charisma would otherwise permit; base morale of any henchman is increased by +1.</summary>
      </ability>
      <ability name="spell_research" level="5">
        <summary>May research spells, scribe magical scrolls, and brew potions beginning at 5th level (Divine Thaumaturge).</summary>
      </ability>
      <ability name="magic_item_creation" level="9">
        <summary>May create more powerful magic items (weapons, rings, staffs) beginning at 9th level (Divine Wizard).</summary>
      </ability>
      <ability name="stronghold_sanctum" level="9">
        <summary>May build a sanctum (often a great tower) at 9th level.</summary>
        <outcomes>
          <outcome>Attracts 1d6 mages or clerics of 1st-3rd level plus 2d6 normal men seeking to become mages or clerics.</outcome>
          <outcome>1d6 months of rigorous training may cause some apprentices to quit.</outcome>
          <outcome>Apprentices must be provided food and lodging but need not be paid wages.</outcome>
        </outcomes>
      </ability>
      <ability name="ritual_magic_and_advanced_creation" level="11">
        <summary>May learn and cast ritual arcane and divine spells of great power, craft magical constructs, and create magical cross-breeds. If chaotic, may create necromantic servants and become undead.</summary>
      </ability>
    </special_abilities>

