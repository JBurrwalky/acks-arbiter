    <special_abilities>
      <ability name="flesh_runes" level="1">
        <summary>Permanent defensive runes replace armor.</summary>
        <rules>
          <rule>At 1st level, flesh-runes grant +2 AC and reduce damage from any non-magical attack by 1 point per die.</rule>
          <rule>At 7th level, flesh-runes grant +4 AC and reduce damage from any non-magical attack by 2 points per die.</rule>
          <rule>At 13th level, flesh-runes grant +6 AC and reduce damage from any non-magical attack by 3 points per die.</rule>
          <rule>Damage reduction is applied separately to each die of damage.</rule>
          <rule>Damage on each die can be reduced to 0, but not below 0.</rule>
          <rule>The AC bonus stacks with potions of invulnerability, rings of protection, and similar effects.</rule>
          <rule>The AC bonus does not stack with armor.</rule>
          <rule>Attacks from monsters of 5 HD or more are treated as magical attacks due to ferocity.</rule>
        </rules>
      </ability>

      <ability name="fighting_fury" level="1">
        <summary>At-will battle fury.</summary>
        <rules>
          <rule>May enter a fighting fury at will.</rule>
          <rule>While furious, gains a +2 bonus to damage rolls.</rule>
          <rule>While furious, is immune to fear.</rule>
        </rules>
        <limits>
          <limit>Cannot retreat from combat while the fighting fury is active.</limit>
          <limit>Once begun, a fighting fury cannot be ended until combat ends.</limit>
        </limits>
      </ability>

      <ability name="savage_resilience" level="1">
        <summary>Improved survival and recovery from mortal wounds.</summary>
        <rules>
          <rule>When required to consult the Mortal Wounds table, may roll twice and choose the preferred result.</rule>
          <rule>Subtracts class level from the number of days of bed rest required to recover.</rule>
        </rules>
      </ability>

      <ability name="dwarven_hardiness" level="1">
        <summary>Dwarven saving throw adjustments are already built into the class save table.</summary>
        <rules>
          <rule>Saving throw target values versus Blast/Breath are reduced by 3.</rule>
          <rule>Saving throw target values versus all other saving throw categories are reduced by 4.</rule>
          <rule>These adjustments are already factored into the printed saving throw table.</rule>
        </rules>
      </ability>

      <ability name="languages" level="1">
        <summary>Starts with multiple languages.</summary>
        <rules>
          <rule>Speaks Common.</rule>
          <rule>Speaks Dwarvish.</rule>
          <rule>Speaks Goblin.</rule>
          <rule>Speaks Gnome.</rule>
          <rule>Speaks Kobold.</rule>
        </rules>
      </ability>

      <ability name="underground_senses" level="1">
        <summary>Improved surprise and hidden-feature detection underground.</summary>
        <rules>
          <rule>Gains a +1 bonus on all surprise rolls when underground.</rule>
          <rule>Can detect false walls, hidden construction, or sloped passages when underground on a proficiency throw of 14+ on 1d20 if actively searching.</rule>
        </rules>
      </ability>
    </special_abilities>

