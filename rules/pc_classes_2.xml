    <special_abilities>
      <ability name="backstab" level="1">
        <summary>Attack unaware opponents for increased accuracy and multiplied damage.</summary>
        <triggers>
          <trigger>Target is unaware due to surprise.</trigger>
          <trigger>Target is unaware because the delver approached using move silently and/or hide in shadows.</trigger>
        </triggers>
        <rules>
          <rule>Receives a +4 bonus on the attack throw when backstabbing.</rule>
          <rule>On a successful backstab, deals additional damage according to the backstab multiplier shown by level.</rule>
        </rules>
      </ability>

      <ability name="expert_caver" level="1">
        <summary>Retains reliable underground route awareness.</summary>
        <rules>
          <rule>When exploring underground caves, cavern complexes, and rivers, may automatically know the route he has taken to reach his current location on a proficiency throw of 9+.</rule>
        </rules>
        <limits>
          <limit>Applies only if the delver was conscious during the travel.</limit>
        </limits>
      </ability>

      <ability name="underground_senses" level="1">
        <summary>Improved surprise and hidden-feature detection underground.</summary>
        <rules>
          <rule>Gains a +1 bonus on all surprise rolls when underground.</rule>
          <rule>Can detect false walls, hidden construction, or sloped passages when underground on a proficiency throw of 14+ on 1d20 if actively searching.</rule>
        </rules>
      </ability>

      <ability name="dwarven_hardiness" level="1">
        <summary>Dwarven saving throw adjustments are already built into the class save table.</summary>
        <rules>
          <rule>Saving throw target values versus Blast/Breath are reduced by 3.</rule>
          <rule>Saving throw target values versus all other saving throw categories are reduced by 4.</rule>
          <rule>These adjustments are already factored into the printed saving throw table.</rule>
        </rules>
      </ability>

      <ability name="languages" level="1">
        <summary>Starts with multiple languages.</summary>
        <rules>
          <rule>Speaks Common.</rule>
          <rule>Speaks Dwarvish.</rule>
          <rule>Speaks Goblin.</rule>
          <rule>Speaks Gnome.</rule>
          <rule>Speaks Kobold.</rule>
        </rules>
      </ability>
    </special_abilities>

